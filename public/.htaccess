# Caché larga para recursos con hash
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|webp|avif|svg|png|jpg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
