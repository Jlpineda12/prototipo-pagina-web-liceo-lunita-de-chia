---
import { Image, getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import NewsCard from '@/components/NewsCard.astro';
import { SITE } from '@/data/site';
import { formatDate, readingTime } from '@/lib/format';

export const getStaticPaths = (async () => {
  const posts = await getCollection('noticias', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, cover, coverAlt, category } = post.data;
const url = new URL(`${import.meta.env.BASE_URL}noticias/${post.id}/`, Astro.site).href;
const og = cover ? await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 78 }) : null;
const mins = readingTime(post.body ?? '');
const related = (await getCollection('noticias', ({ id, data }) => id !== post.id && !data.draft))
  .sort((a, b) => Number(b.data.category === category) - Number(a.data.category === category) || b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const themeByCat: Record<string, string> = { Bandas: 't-purple', Celebraciones: 't-orange', Académico: 't-green', Excursiones: 't-sky', Noticias: 't-red' };
const share = encodeURIComponent(`${title} — ${url}`);
---

<Base
  title={title}
  description={description}
  type="article"
  image={og?.src}
  imageAlt={coverAlt}
  published={date}
  modified={updated ?? date}
  breadcrumbs={[{ name: 'Noticias', href: '/noticias/' }, { name: title, href: `/noticias/${post.id}/` }]}
  schema={{
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    headline: title,
    description,
    image: og ? [new URL(og.src, Astro.site).href] : undefined,
    datePublished: date.toISOString(),
    dateModified: (updated ?? date).toISOString(),
    author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    publisher: { '@type': 'Organization', name: SITE.name, logo: { '@type': 'ImageObject', url: `${SITE.url}/icon-512.png` } },
    mainEntityOfPage: url,
    articleSection: category,
    inLanguage: 'es-CO',
  }}
>
  <article class={`article ${themeByCat[category]}`}>
    <header class="head">
      <div class="wrap narrow">
        <nav aria-label="Migas de pan" class="crumbs"><a href="/">Inicio</a> › <a href="/noticias/">Noticias</a></nav>
        <span class="chip">{category}</span>
        <h1>{title}</h1>
        <p class="meta"><Icon name="calendar" size={16} /> <time datetime={date.toISOString()}>{formatDate(date)}</time> · {mins} min de lectura</p>
      </div>
    </header>
    {cover && (
      <div class="wrap cover-wrap">
        <figure class="cover card"><Image src={cover} alt={coverAlt} widths={[480, 800, 1200]} sizes="(min-width: 1000px) 960px, 100vw" loading="eager" fetchpriority="high" format="webp" quality={75} /></figure>
      </div>
    )}
    <div class="wrap narrow body">
      <div class="prose"><Content /></div>
      <aside class="share card" aria-label="Compartir">
        <strong>¿Te gustó? ¡Compártela!</strong>
        <div>
          <a class="btn sm green" href={`https://wa.me/?text=${share}`} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" /> WhatsApp</a>
          <a class="btn sm sky" href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`} target="_blank" rel="noopener noreferrer"><Icon name="facebook" /> Facebook</a>
        </div>
      </aside>
    </div>
  </article>

  <section class="section bg-2" aria-labelledby="rel-title">
    <div class="wrap">
      <h2 id="rel-title" class="rel-t">Más noticias</h2>
      <div class="grid cols-3">{related.map((p, i) => <NewsCard post={p} index={i} />)}</div>
      <p class="all"><a class="btn outline" href="/noticias/">Ver todas las noticias <Icon name="arrow" /></a></p>
    </div>
  </section>
</Base>

<style>
  .narrow { max-width: 820px; }
  .head { background: var(--l); padding: 2.5rem 0 6rem; }
  .crumbs { font-size: 0.85rem; font-weight: 700; color: var(--muted); margin-bottom: 1.2rem; }
  .crumbs a { color: var(--ct); text-decoration: none; }
  .chip { --c: var(--cd); }
  h1 { font-size: var(--step-4); margin: 0.8rem 0; }
  .meta { display: flex; align-items: center; gap: 0.4rem; margin: 0; font-weight: 700; color: var(--muted); }
  .cover-wrap { max-width: 1000px; margin-top: -4.5rem; }
  .cover { margin: 0; padding: 0; overflow: hidden; }
  .cover :global(img) { width: 100%; max-height: 560px; object-fit: cover; }
  .body { padding-block: 2.5rem 4rem; }
  .share { margin-top: 2.5rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; }
  .share strong { color: var(--navy); }
  .share div { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .rel-t { font-size: var(--step-3); }
  .all { margin-top: 2rem; text-align: center; }
</style>
