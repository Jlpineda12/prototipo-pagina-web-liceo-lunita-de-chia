---
import { Image } from 'astro:assets';
import festival from '@/assets/site/festival-bandas.webp';
import honduras from '@/assets/site/banda-honduras.webp';
import Icon from '../Icon.astro';
---

<section class="section bands block block-lilac" aria-labelledby="bands-title">
  <div class="notes" aria-hidden="true">{['♪', '♫', '♩', '♬', '♪'].map((n, i) => <span style={`--i:${i}`}>{n}</span>)}</div>
  <div class="wrap">
    <div class="head">
      <div class="section-head">
        <p class="kicker t-purple" style="color:var(--purple-d)"><span class="dot"></span>Banda Marcial Liceo Lunita</p>
        <h2 id="bands-title">Chía, Ciudad de la Luna, <span class="hl">suena al mundo</span></h2>
        <p>Desde 2023 organizamos el Festival Internacional de Bandas Marciales “Ciudad de la Luna”. Nuestra banda ya representó a Colombia en Honduras.</p>
      </div>
      <a class="btn sky" href="/festival-de-bandas/">Ver el festival <Icon name="arrow" /></a>
    </div>
    <div class="mosaic">
      <figure class="card m1" data-reveal>
        <Image src={festival} alt="Festival Internacional de Bandas Marciales en Chía" widths={[480, 800, 1200]} sizes="(min-width: 960px) 60vw, 100vw" format="webp" quality={72} />
        <figcaption><span class="chip t-purple">4.ª edición</span> Festival Internacional de Bandas</figcaption>
      </figure>
      <figure class="card m2" data-reveal style="--d:1">
        <Image src={honduras} alt="La Banda Marcial del Liceo Lunita de Chía rumbo a Honduras" widths={[400, 700]} sizes="(min-width: 960px) 36vw, 100vw" format="webp" quality={72} />
        <figcaption><span class="chip t-sky">Viaje</span> Rumbo a San Pedro Sula, Honduras</figcaption>
      </figure>
      <div class="card eq t-purple" data-reveal style="--d:2" aria-hidden="true">{Array.from({ length: 12 }, (_, i) => <i style={`--i:${i}`} />)}</div>
    </div>
  </div>
</section>

<style>
  .bands { overflow: hidden; }
  .notes span { position: absolute; top: calc(8% + var(--i) * 6%); right: calc(4% + var(--i) * 9%); font-size: 2rem; color: var(--purple); opacity: 0.35; animation: bob 4s ease-in-out infinite; animation-delay: calc(var(--i) * -0.8s); }
  .head { position: relative; display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1.5rem; margin-bottom: 2.4rem; }
  .head .section-head { margin: 0; }
  .mosaic { display: grid; gap: 1rem; }
  @media (min-width: 960px) { .mosaic { grid-template-columns: 1.6fr 1fr; } .m1 { grid-row: span 2; } }
  figure { margin: 0; padding: 0; overflow: hidden; display: flex; flex-direction: column; }
  figure :global(img) { width: 100%; flex: 1; object-fit: cover; min-height: 0; }
  figcaption { display: flex; align-items: center; gap: 0.6rem; padding: 0.9rem 1.1rem; font-weight: 800; color: var(--navy); }
  .eq { display: flex; align-items: end; justify-content: center; gap: 6px; min-height: 110px; background: var(--purple-l); border-color: var(--purple); }
  .eq i { flex: 1; max-width: 14px; border-radius: 6px; background: var(--purple); height: 30%; animation: eq 1s ease-in-out infinite alternate; animation-delay: calc(var(--i) * -0.13s); }
  .eq i:nth-child(3n) { background: var(--yellow); }
  .eq i:nth-child(4n) { background: var(--sky); }
  @keyframes eq { from { height: 15%; } to { height: 95%; } }
</style>
