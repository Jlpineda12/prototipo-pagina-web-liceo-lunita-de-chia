---
/** Nuestro nombre: homenaje a Chía, diosa muisca de la luna, con fases lunares animadas. */
const phase = (i: number) => {
  const t = i / 7;
  const rx = Math.abs(Math.cos(t * Math.PI)) * 28;
  return `M30 2 A28 28 0 0 1 30 58 A${rx.toFixed(1)} 28 0 0 ${t < 0.5 ? 0 : 1} 30 2Z`;
};
---

<section class="section name block block-sky" aria-labelledby="name-title">
  <div class="wrap layout">
    <div class="visual card" data-reveal>
      <p class="cap">Las fases de Chía</p>
      <div class="phases" aria-hidden="true">
        {Array.from({ length: 8 }, (_, i) => (
          <svg viewBox="0 0 60 60" style={`--i:${i}`}>
            <circle cx="30" cy="30" r="28" fill="#e7e8fb" />
            <path d={phase(i)} fill="#ffc800" />
          </svg>
        ))}
      </div>
      <figure class="quote">
        <blockquote><p>Chiminigagua le encomendó a Chía la noble tarea de alumbrar la oscuridad de las noches.</p></blockquote>
        <figcaption>Tradición muisca</figcaption>
      </figure>
    </div>
    <div>
      <p class="kicker"><span class="dot"></span>Nuestro nombre</p>
      <h2 id="name-title">Un homenaje a la <span class="hl">diosa de la luna</span></h2>
      <p>
        En la mitología muisca, <strong>Chía</strong> —también llamada Chíe— es la diosa de la luna, esposa de Sua, el sol. Simboliza la fiesta, la alegría
        y la creatividad. Muchos de nuestros estudiantes pertenecen o descienden del <strong>resguardo indígena de Chía</strong>, y esa raíz guía nuestro
        proyecto educativo.
      </p>
      <p>Tomamos su luz como un llamado: iluminar el camino de cada estudiante con creatividad, innovación y pasión por aprender.</p>
      <a class="link" href="/el-cole/#nombre">Conoce nuestra historia <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
  </div>
</section>

<style>
  .layout { display: grid; gap: 3rem; align-items: center; }
  @media (min-width: 960px) { .layout { grid-template-columns: 1fr 1fr; gap: 4.5rem; } }
  h2 { font-size: var(--step-4); }
  .layout p { color: var(--ink-2); font-size: 1.06rem; }
  .cap { font-weight: 900; color: var(--blue); text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.8rem; }
  .phases { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.8rem; }
  .phases svg { width: 100%; height: auto; animation: bob 4s ease-in-out infinite; animation-delay: calc(var(--i) * -0.5s); }
  @supports (animation-timeline: view()) {
    .phases svg { animation: phase-in linear both, bob 4s ease-in-out infinite; animation-timeline: view(), auto; animation-range: entry calc(var(--i) * 5%) cover 35%, normal; }
    @keyframes phase-in { from { opacity: 0; transform: scale(0.4) rotate(-60deg); } to { opacity: 1; transform: none; } }
  }
  .quote { margin: 1.6rem 0 0; padding: 1.1rem 1.3rem; border-radius: var(--r); background: var(--yellow-l); }
  .quote blockquote { margin: 0; }
  .quote p { margin: 0; font-weight: 800; color: var(--navy); font-size: 1.05rem; }
  .quote figcaption { margin-top: 0.4rem; font-size: 0.78rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--yellow-d); }
</style>
