---
/**
 * Hero centrado (inspirado en la estructura de SuperHi, con la esencia Lunita):
 *  - Lunita (Rive) arriba: entra con un rebote, reacciona al cursor y salta cada vez que cambia la palabra.
 *  - Titular grande con palabra rotativa en "sticker" de color (luz propia · ciencia · arte · música · valores).
 *  - Fondo claro y sencillo con figuras planas del mundo Lunita (luna, planeta, cerro, estrella, rombo muisca,
 *    sol) que se asoman por los bordes, flotan, siguen el cursor (paralaje) y se abren al hacer scroll.
 *  - Botones sticker del sitio. Solo transform/opacity; todo se pausa fuera de pantalla y respeta reduced-motion.
 */
import Lunita from '../brand/Lunita.astro';
import Icon from '../Icon.astro';

const WORDS = [
  { t: 'luz propia', c: '#ffc800', d: '#e5a400', fg: '#0f1747' },
  { t: 'ciencia', c: '#1cb0f6', d: '#1899d6', fg: '#fff' },
  { t: 'arte', c: '#ff86d0', d: '#e266b3', fg: '#fff' },
  { t: 'música', c: '#ce82ff', d: '#a568cc', fg: '#fff' },
  { t: 'valores', c: '#58cc02', d: '#46a302', fg: '#fff' },
];

// Figuras: color, sombra, profundidad de paralaje y dirección al hacer scroll (x, y, giro)
const SHAPES = [
  { k: 'moon', c: '#ffc800', d: '#e5a400', z: 1.2, dir: [-1, -0.6, -1] },
  { k: 'planet', c: '#1cb0f6', d: '#1899d6', z: 0.8, dir: [1, -0.7, 1] },
  { k: 'hill', c: '#58cc02', d: '#46a302', z: 0.6, dir: [-1, 0.2, 1] },
  { k: 'star', c: '#303296', d: '#22246f', z: 1, dir: [-0.6, 1, -1] },
  { k: 'rombo', c: '#ff9600', d: '#e08600', z: 0.7, dir: [1, 0.1, -1] },
  { k: 'sun', c: '#ce82ff', d: '#a568cc', z: 1.1, dir: [0.7, 1, 1] },
];
const star = (cx: number, cy: number, R: number, r: number, n = 5) =>
  Array.from({ length: n * 2 }, (_, i) => {
    const a = ((-90 + (i * 180) / n) * Math.PI) / 180, rr = i % 2 ? r : R;
    return `${i ? 'L' : 'M'}${(cx + rr * Math.cos(a)).toFixed(1)} ${(cy + rr * Math.sin(a)).toFixed(1)}`;
  }).join('') + 'Z';
const PATHS: Record<string, string> = {
  moon: 'M126 18A84 84 0 1 0 184 140A68 68 0 0 1 126 18Z',
  hill: 'M22 168 L84 62 Q100 36 116 62 L178 168 Z',
  star: star(100, 104, 84, 40),
  sun: star(100, 100, 88, 62, 12),
  rombo: 'M100 12 L188 100 L100 188 L12 100 Z',
};
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="shapes" aria-hidden="true">
    {SHAPES.map((s, i) => (
      <div class={`shape s-${s.k}`} data-shape data-z={s.z} data-dir={s.dir.join(',')} style={`--i:${i}`}>
        <div class="pop">
          <svg viewBox="0 0 200 200" style={`--c:${s.c}; --cd:${s.d}`}>
            {s.k === 'planet' ? (
              <>
                <circle cx="100" cy="110" r="62" fill="var(--cd)" />
                <circle cx="100" cy="100" r="62" fill="var(--c)" />
                <circle cx="78" cy="80" r="12" fill="#fff" opacity=".35" />
                <ellipse cx="100" cy="104" rx="96" ry="26" fill="none" stroke="var(--cd)" stroke-width="12" transform="rotate(-16 100 104)" />
              </>
            ) : s.k === 'rombo' ? (
              <>
                <path d={PATHS.rombo} transform="translate(0 10)" fill="var(--cd)" stroke="var(--cd)" stroke-width="16" stroke-linejoin="round" />
                <path d={PATHS.rombo} fill="var(--c)" stroke="var(--c)" stroke-width="16" stroke-linejoin="round" />
                <path d="M100 58 L142 100 L100 142 L58 100 Z" fill="#fff" opacity=".9" />
                <path d="M100 84 L116 100 L100 116 L84 100 Z" fill="var(--c)" />
              </>
            ) : (
              <>
                <path d={PATHS[s.k]} transform="translate(0 10)" fill="var(--cd)" stroke="var(--cd)" stroke-width="14" stroke-linejoin="round" />
                <path d={PATHS[s.k]} fill="var(--c)" stroke="var(--c)" stroke-width="14" stroke-linejoin="round" />
                {s.k === 'moon' && <circle cx="66" cy="70" r="10" fill="#fff" opacity=".35" />}
                {s.k === 'hill' && <path d="M84 62 Q100 36 116 62 L108 76 L100 68 L92 78 Z" fill="#fff" />}
                {s.k === 'sun' && <circle cx="100" cy="100" r="36" fill="#fff" opacity=".9" />}
              </>
            )}
          </svg>
        </div>
      </div>
    ))}
  </div>

  <div class="wrap center">
    <div class="luni-wrap" data-luni>
      <div class="orbits" aria-hidden="true">
        <svg viewBox="-900 -900 1800 1800">
          {[150, 250, 370, 510, 680, 870].map((r, i) => (
            <circle class:list={['orb', { dash: i === 2 }]} r={r} pathLength="1" style={`--o:${i}`} />
          ))}
        </svg>
        {/* Satélites: giran con transform en HTML (los anima la GPU, sin repintar el SVG) */}
        <span class="sat" style="--r:250; --t:46s; --c:var(--yellow); --z:16px; --a0:0deg"><i></i></span>
        <span class="sat ring" style="--r:510; --t:80s; --c:var(--sky); --z:22px; --a0:-90deg; --dir:reverse"><i></i></span>
        <span class="sat" style="--r:680; --t:120s; --c:#58cc02; --z:12px; --a0:180deg"><i></i></span>
      </div>
      <span class="glow" aria-hidden="true"></span>
      <Lunita size={230} pose="hola" class="hero-luni" rive intro label="Lunita, la mascota del Liceo Lunita de Chía" />
    </div>

    <h1 id="hero-title" class="title">
      <span class="sr-only">Liceo Lunita de Chía, colegio en Chía: </span>
      <span class="l1">Donde cada estudiante</span>
      <span class="l2">brilla con <span class="rot" data-rot aria-hidden="true">{WORDS.map((w, i) => (
        <span class:list={['word', { on: i === 0 }]} style={`--wc:${w.c}; --wd:${w.d}; --wf:${w.fg}`}>{w.t}</span>
      ))}</span><span class="sr-only">luz propia</span></span>
    </h1>

    <p class="lead">
      Preescolar, primaria y bachillerato en Chía con el modelo <strong>STHEAMI</strong>.
      Más de <strong><span data-count="180">180</span> bachilleres</strong> graduados en <strong>12 promociones</strong>.
    </p>

    <div class="ctas">
      <a class="btn" href="/admisiones/">Matrículas 2027 <Icon name="arrow" /></a>
      <a class="btn blue" href="/el-cole/">Conoce el colegio</a>
    </div>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fine = matchMedia('(pointer: fine)').matches;
    const luni = hero.querySelector<HTMLElement>('[data-luni] .lunita');

    /* ---------- Palabra rotativa + Lunita salta en cada cambio ---------- */
    const rot = hero.querySelector<HTMLElement>('[data-rot]')!;
    const words = [...rot.querySelectorAll<HTMLElement>('.word')];
    let w = 0, wTimer = 0, visible = true, cycles = 0, hold = false;
    const MAX_CYCLES = 2; // se detiene en "luz propia" tras dos vueltas (WCAG 2.2.2)
    const fit = () => { rot.style.width = `${words[w].offsetWidth}px`; };
    const jump = () => {
      const api = (luni as any)?.__lunita;
      if (api) api.tap();
      else if (luni) { luni.classList.remove('is-jump'); void luni.offsetWidth; luni.classList.add('is-jump'); }
    };
    const next = () => {
      const old = words[w];
      old.classList.remove('on'); old.classList.add('out');
      setTimeout(() => old.classList.remove('out'), 500);
      w = (w + 1) % words.length;
      if (w === 0 && ++cycles >= MAX_CYCLES) clearInterval(wTimer);
      words[w].classList.add('on');
      fit();
      jump();
    };
    const loop = () => { clearInterval(wTimer); if (!reduce && visible && !hold && cycles < MAX_CYCLES && !document.hidden) wTimer = window.setInterval(next, 2600); };
    const title = hero.querySelector<HTMLElement>('.title')!;
    title.addEventListener('pointerenter', () => { hold = true; loop(); });
    title.addEventListener('pointerleave', () => { hold = false; loop(); });
    fit();
    document.fonts?.ready.then(fit);
    addEventListener('resize', fit);

    /* ---------- Figuras: paralaje con el cursor + apertura con el scroll ---------- */
    const shapes = [...hero.querySelectorAll<HTMLElement>('[data-shape]')].map((el) => ({
      el, z: Number(el.dataset.z), dir: el.dataset.dir!.split(',').map(Number), x: 0, y: 0, r: 0,
    }));
    let mx = 0, my = 0, raf = 0;
    const tick = () => {
      raf = 0;
      const s = Math.min(1, Math.max(0, scrollY / (hero.offsetHeight * 0.9)));
      let moving = false;
      for (const p of shapes) {
        const tx = mx * 26 * p.z + p.dir[0] * s * 160;
        const ty = my * 20 * p.z + p.dir[1] * s * 120;
        const tr = p.dir[2] * s * 28 + mx * 4 * p.z;
        p.x += (tx - p.x) * 0.09; p.y += (ty - p.y) * 0.09; p.r += (tr - p.r) * 0.09;
        if (Math.abs(tx - p.x) + Math.abs(ty - p.y) + Math.abs(tr - p.r) > 0.1) moving = true;
        p.el.style.transform = `translate3d(${p.x.toFixed(2)}px, ${p.y.toFixed(2)}px, 0) rotate(${p.r.toFixed(2)}deg)`;
      }
      if (moving && visible) raf = requestAnimationFrame(tick);
    };
    const kick = () => { if (!raf && !reduce) raf = requestAnimationFrame(tick); };
    if (fine) hero.addEventListener('pointermove', (e) => { mx = (e.clientX / innerWidth) * 2 - 1; my = (e.clientY / innerHeight) * 2 - 1; kick(); }, { passive: true });
    addEventListener('scroll', kick, { passive: true });

    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      hero.classList.toggle('is-off', !visible);
      loop(); if (visible) kick();
    }).observe(hero);
    document.addEventListener('visibilitychange', loop);
  }
</script>

<style>
  .hero { position: relative; overflow: hidden; isolation: isolate; min-height: min(100svh, 900px); display: grid; align-items: center;
    padding: calc(var(--header-h) + clamp(2rem, 5vw, 3.5rem)) 0 clamp(10.5rem, 16vw, 13.5rem) !important;
    /* Marfil cálido plano: propio y sereno; el color lo ponen Lunita, las figuras y el titular */
    background: var(--hero-bg); --hero-bg: #fbf6ec; }

  /* Mientras la pantalla de carga está encima, toda la coreografía del hero espera */
  :global(html[data-splash='1']) .hero *, :global(html[data-nav-in='1']) .hero * { animation-play-state: paused !important; }

  /* ---------- Órbitas lunares (se dibujan al entrar) ---------- */
  .orbits { position: absolute; left: 50%; top: 50%; width: clamp(1150px, 125vw, 1800px); aspect-ratio: 1; translate: -50% -50%; z-index: -2; pointer-events: none; }
  .orbits svg { width: 100%; height: 100%; max-width: none; overflow: visible; }
  .orb { fill: none; stroke: rgb(15 23 71 / 0.1); stroke-width: 1.6; vector-effect: non-scaling-stroke; }
  .orb:nth-child(odd) { stroke: rgb(15 23 71 / 0.07); }
  .orb.dash { stroke: rgb(48 50 150 / 0.22); stroke-dasharray: 0.002 0.012; stroke-linecap: round; stroke-width: 3; }
  :global(.js) .orb:not(.dash) { stroke-dasharray: 1; stroke-dashoffset: 1; animation: orb-draw 1.6s var(--ease) forwards; animation-delay: calc(0.35s + var(--o) * 0.12s); }
  :global(.js) .orb.dash { opacity: 0; animation: fade-in 1s 0.7s forwards; }
  @keyframes orb-draw { to { stroke-dashoffset: 0; } }
  @keyframes fade-in { to { opacity: 1; } }
  .sat { position: absolute; left: 50%; top: 50%; width: calc(var(--r) / 900 * 100%); aspect-ratio: 1; translate: -50% -50%; rotate: var(--a0); animation: orbit var(--t) linear infinite var(--dir, normal); will-change: transform; }
  .sat i { position: absolute; left: 100%; top: 50%; width: var(--z); height: var(--z); margin: calc(var(--z) / -2); border-radius: 50%; background: var(--c); }
  .sat.ring i { box-shadow: 0 0 0 7px color-mix(in srgb, var(--c) 22%, transparent); }
  :global(.js) .sat i { opacity: 0; animation: fade-in 0.8s 1.4s forwards; }
  @keyframes orbit { to { transform: rotate(360deg); } }
  .is-off .sat { animation-play-state: paused; }

  /* ---------- Figuras ---------- */
  .shapes { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .shape { position: absolute; will-change: transform; }
  .shape svg { display: block; width: 100%; height: auto; overflow: visible; animation: float 7s ease-in-out infinite; animation-delay: calc(var(--i) * -1.3s); }
  .pop { transform-origin: center; }
  :global(.js) .pop { transform: scale(0) rotate(-30deg); animation: pop 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) forwards; animation-delay: calc(var(--i) * 90ms + 200ms); }
  @keyframes pop { to { transform: none; } }
  @keyframes float { 0%, 100% { transform: translateY(0) rotate(0); } 50% { transform: translateY(-14px) rotate(4deg); } }
  .is-off .shape svg { animation-play-state: paused; }

  .s-moon   { left: -3%;  top: 9%;     width: clamp(150px, 21vw, 330px); rotate: -12deg; }
  .s-planet { right: -4%; top: 6%;     width: clamp(150px, 21vw, 320px); }
  .s-hill   { left: -5%;  top: 52%;    width: clamp(130px, 17vw, 270px); }
  .s-star   { left: 8%;   bottom: 14%; width: clamp(120px, 15vw, 240px); rotate: 10deg; }
  .s-rombo  { right: 4%;  top: 48%;    width: clamp(100px, 12vw, 190px); rotate: 8deg; }
  .s-sun    { right: -3%; bottom: 8%; width: clamp(140px, 19vw, 290px); }

  /* ---------- Contenido centrado ---------- */
  .center { position: relative; text-align: center; display: grid; justify-items: center; max-width: 900px; }
  .luni-wrap { position: relative; width: clamp(140px, 16vw, 230px); margin-bottom: 0.6rem; }
  .glow { position: absolute; inset: 8%; border-radius: 50%; background: radial-gradient(circle, rgb(255 200 0 / 0.45), transparent 68%); filter: blur(6px); }
  :global(.hero-luni) { position: relative; width: 100%; height: auto; cursor: pointer; }
  /* La entrada de Lunita la hace Rive (animación Intro); aquí solo se enciende el halo */
  :global(.js) .glow { animation: glow-in 1.1s 0.15s cubic-bezier(0.22, 1, 0.36, 1) both; }
  @keyframes glow-in { from { opacity: 0; transform: scale(0.2); } }

  .title { margin: 0 0 1.2rem; color: var(--navy); font-size: clamp(2.5rem, 1.1rem + 5vw, 5.3rem); font-weight: 900; letter-spacing: -0.045em; line-height: 1.02; }
  .l1, .l2 { display: block; }
  :global(.js) .l1, :global(.js) .l2 { opacity: 0; transform: translateY(28px); animation: rise 0.9s var(--ease) forwards; }
  :global(.js) .l1 { animation-delay: 0.25s; } :global(.js) .l2 { animation-delay: 0.38s; }
  @keyframes rise { to { opacity: 1; transform: none; } }

  /* Palabra rotativa en sticker de color */
  .rot { position: relative; display: inline-grid; vertical-align: bottom; height: 1.18em; transition: width 0.55s cubic-bezier(0.34, 1.3, 0.64, 1); }
  .word { grid-area: 1 / 1; justify-self: start; white-space: nowrap; padding: 0 0.22em 0.04em; border-radius: 0.24em; background: var(--wc); color: var(--wf); box-shadow: 0 0.09em 0 var(--wd);
    opacity: 0; transform: translateY(70%) rotate(-4deg) scale(0.9); transition: opacity 0.35s, transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .word.on { opacity: 1; transform: rotate(-1.5deg); }
  .word.out { opacity: 0; transform: translateY(-70%) rotate(3deg) scale(0.9); transition: opacity 0.3s, transform 0.4s ease-in; }

  .lead { margin: 0 auto; max-width: 52ch; font-size: clamp(1.02rem, 0.92rem + 0.45vw, 1.28rem); line-height: 1.55; color: var(--ink-2); }
  .lead strong { color: var(--navy); }
  .ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.8rem; margin-top: 2rem; }
  :global(.js) .lead, :global(.js) .ctas { opacity: 0; transform: translateY(18px); animation: rise 0.8s var(--ease) forwards; }
  :global(.js) .lead { animation-delay: 0.55s; } :global(.js) .ctas { animation-delay: 0.7s; }

  /* ---------- Responsive ---------- */
  @media (max-width: 900px) {
    .s-hill, .s-rombo { display: none; }
    .s-moon { top: 7%; left: -12%; width: 34vw; }
    .s-planet { top: 9%; right: -12%; width: 34vw; }
    .s-star { left: -6%; bottom: 4%; width: 28vw; }
    .s-sun { right: -10%; bottom: 2%; width: 32vw; }
  }
  @media (max-width: 560px) {
    .hero { min-height: 0; padding-top: calc(var(--header-h) + 1.6rem) !important; padding-bottom: 10rem !important; }
    .title { font-size: clamp(2.2rem, 10.5vw, 2.9rem); }
    .lead { font-size: 1rem; }
    .ctas { width: 100%; }
    .ctas .btn { flex: 1 1 100%; }
    .s-moon { top: 9%; width: 30vw; } .s-planet { top: 11%; width: 30vw; }
    .s-star, .s-sun { bottom: 1%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .shape svg, .sat, :global(.js) .sat i, :global(.js) .orb, :global(.js) .pop, :global(.js) .glow, :global(.js) .l1, :global(.js) .l2, :global(.js) .lead, :global(.js) .ctas { animation: none !important; opacity: 1; transform: none; }
    :global(.js) .orb:not(.dash) { stroke-dashoffset: 0; }
  }
</style>
