---
import Sticker from '@/components/Sticker.astro';
import { STHEAMI } from '@/data/site';
import Lunita from '../brand/Lunita.astro';
import Icon from '../Icon.astro';
---

<section class="hero block block-cobalt" aria-labelledby="hero-title">
  <!-- Órbitas decorativas (educación aeroespacial) -->
  <svg class="orbits" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <ellipse cx="1060" cy="420" rx="520" ry="300" />
    <ellipse cx="1060" cy="420" rx="700" ry="420" />
    <circle class="sat" r="6" cx="0" cy="0"><animateMotion dur="38s" repeatCount="indefinite" path="M540 420a520 300 0 1 0 1040 0a520 300 0 1 0-1040 0" /></circle>
  </svg>

  <div class="wrap grid">
    <div class="copy">
      <h1 id="hero-title" class="hero-title">
        <span class="line" style="--d:0">Un colegio en Chía</span>
        <span class="line" style="--d:1">donde cada estudiante</span>
        <span class="line accent" style="--d:2">brilla con luz propia</span>
      </h1>
      <p class="lead" data-reveal style="--d:4">
        Preescolar, primaria y bachillerato con el modelo <strong>STHEAMI</strong>, proyección internacional y la mirada puesta en las estrellas.
      </p>
      <div class="ctas" data-reveal style="--d:5">
        <a class="btn" href="/admisiones/">Matrículas 2027 <Icon name="arrow" /></a>
        <a class="btn outline" href="/el-cole/">Conoce el colegio</a>
      </div>
      <ul class="trust" data-reveal style="--d:6" aria-label="Destacados">
        <li class="t-yellow"><Sticker name="award" size={28} tile={false} /><span><b>Premio</b> Excelencia Educativa 2026</span></li>
        <li class="t-sky"><Sticker name="rocket" size={28} tile={false} /><span><b>NASA</b> Space Apps Challenge</span></li>
        <li class="t-purple"><Sticker name="music" size={28} tile={false} /><span><b>Festival</b> Internacional de Bandas</span></li>
      </ul>
    </div>

    <div class="stage" data-reveal="pop" style="--d:2">
      <div class="halo" aria-hidden="true"></div>
      <div class="orbit" aria-label="Componentes del modelo STHEAMI">
        <ul>
          {STHEAMI.map((s, i) => (
            <li style={`--a:${(360 / STHEAMI.length) * i}deg; --c:${s.color}`}>
              <a href="/modelo-stheami/" title={s.name}><b aria-hidden="true">{s.k}</b><span class="sr-only">{s.name}</span></a>
            </li>
          ))}
        </ul>
      </div>
      <!-- Lunita vectorial interactiva con seguimiento ocular 60 fps y paralaje 2.5D -->
      <Lunita size={380} pose="hola" class="hero-luni" />
    </div>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; padding: calc(var(--header-h) + clamp(1.2rem, 3.6vw, 2.8rem)) 0 clamp(5.5rem, 10vw, 9rem) !important; }
  .orbits { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .orbits ellipse { fill: none; stroke: rgb(255 255 255 / 0.13); stroke-width: 2; stroke-dasharray: 4 10; }
  .orbits .sat { fill: var(--yellow); }

  .grid { position: relative; display: grid; gap: 1.4rem; align-items: center; }
  .grid > * { min-width: 0; }
  @media (min-width: 960px) { .grid { grid-template-columns: 1.32fr 1fr; gap: 2.2rem; min-height: min(580px, 68vh); } }

  .hero-title { font-size: clamp(1.9rem, 1.05rem + 3vw, 3.55rem); overflow-wrap: anywhere; line-height: 1.05; margin-bottom: 1rem; }
  .line { display: block; overflow: clip; padding-bottom: 0.06em; }
  .line::before { content: none; }
  .js .line { clip-path: inset(0 0 100% 0); transform: translateY(0.4em); animation: line-in 0.85s var(--ease) forwards; animation-delay: calc(var(--d) * 100ms + 120ms); }
  @keyframes line-in { to { clip-path: inset(0 0 -10% 0); transform: none; } }
  .accent { color: var(--yellow); position: relative; width: fit-content; }
  .accent::after { content: ''; position: absolute; left: 0; right: 0; bottom: -0.02em; height: 0.16em; border-radius: 99px; background: rgb(255 200 0 / 0.35); transform-origin: left; transform: scaleX(0); animation: underline 0.75s 0.85s var(--ease) forwards; }
  @keyframes underline { to { transform: scaleX(1); } }

  .lead { font-size: clamp(0.98rem, 0.9rem + 0.45vw, 1.2rem); color: rgb(255 255 255 / 0.88); max-width: 44ch; line-height: 1.5; margin: 0; }
  .lead strong { color: #fff; }
  .ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.4rem; }

  /* Pastillas de confianza con wrap limpio (nunca se recortan a mitad de palabra) */
  .trust {
    list-style: none;
    margin: 1.6rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.85rem 0.3rem 0.4rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.11);
    border: 1.5px solid rgb(255 255 255 / 0.2);
    font-size: 0.8rem;
    font-weight: 700;
    color: rgb(255 255 255 / 0.92);
  }
  .trust b { color: #fff; font-weight: 900; }
  .trust :global(.sticker) { --c: var(--yellow); --cd: #e5a400; }
  .trust .t-sky :global(.sticker) { --c: #7fd4ff; --cd: #1cb0f6; }
  .trust .t-purple :global(.sticker) { --c: #e3b8ff; --cd: #ce82ff; }

  /* Escenario: Lunita con las 7 letras STHEAMI en órbita */
  .stage {
    position: relative;
    width: min(100%, 460px);
    aspect-ratio: 1;
    margin-inline: auto;
    display: grid;
    place-items: center;
    container-type: inline-size;
  }
  .halo {
    position: absolute;
    inset: 17%;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, #fff, #e9ecff 70%);
    box-shadow: 0 0 0 14px rgb(255 255 255 / 0.12), 0 0 0 30px rgb(255 255 255 / 0.06), 0 30px 80px -20px rgb(0 0 0 / 0.45);
  }
  .orbit { position: absolute; inset: 0; }
  .orbit ul { position: absolute; inset: 0; list-style: none; margin: 0; padding: 0; animation: spin 60s linear infinite; }
  .stage:hover .orbit ul, .stage:focus-within .orbit ul { animation-play-state: paused; }
  .orbit li { position: absolute; left: 50%; top: 50%; transform: rotate(var(--a)) translate(0, -45cqi); }
  .orbit a {
    position: absolute; translate: -50% -50%; display: grid; place-items: center;
    width: clamp(36px, 12cqi, 56px); aspect-ratio: 1; border-radius: 50%; text-decoration: none;
    background: var(--c); box-shadow: 0 4px 0 color-mix(in oklab, var(--c) 72%, #000);
    color: #fff; font-weight: 900; font-size: clamp(0.95rem, 4.4cqi, 1.35rem);
    transition: transform 0.2s var(--spring);
  }
  .orbit a b { rotate: calc(-1 * var(--a)); animation: spin 60s linear infinite reverse; text-shadow: 0 2px 0 rgb(0 0 0 / 0.15); }
  .stage:hover .orbit a b { animation-play-state: paused; }
  .orbit a:hover { transform: scale(1.18); }
  :global(.hero-luni) { position: relative; width: 70%; height: auto; cursor: pointer; }

  /* Responsive pulido para Tablet (768px) y Celular (390px) */
  @media (max-width: 959px) {
    .grid { text-align: center; justify-items: center; }
    .copy { display: grid; justify-items: center; }
    .accent { margin-inline: auto; }
    .ctas, .trust { justify-content: center; }
    .stage { width: min(82vw, 330px); order: -1; }
  }
  @media (max-width: 560px) {
    .hero { padding-top: calc(var(--header-h) + 0.75rem) !important; }
    .stage { width: min(74vw, 268px); }
    .hero-title { font-size: clamp(1.75rem, 7.6vw, 2.25rem); margin-bottom: 0.75rem; }
    .lead { font-size: 0.96rem; }
    .ctas { margin-top: 1.1rem; width: 100%; }
    .ctas .btn { flex: 1 1 auto; justify-content: center; }
    .trust { margin-top: 1.2rem; gap: 0.4rem; }
    .trust li { font-size: 0.74rem; padding: 0.25rem 0.7rem 0.25rem 0.35rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .js .line, .accent::after { animation: none; clip-path: none; transform: none; }
    .orbit ul, .orbit a b { animation: none; }
  }
</style>
