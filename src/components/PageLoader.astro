---
/**
 * Pantallas de carga "Fases de color" — sencillas, ingeniosas y livianas (solo CSS transform).
 *  - Cinco columnas con los colores de apoyo del sitio cubren la pantalla en cascada y luego se levantan,
 *    dejando ver un destello de color entre capa y capa.
 *  - En el centro, la media luna del escudo se forma como una fase lunar: un disco amarillo
 *    al que "muerde" un círculo del color de fondo.
 *  - Primera visita de la sesión (o ?intro=1): breve intro con el nombre del colegio.
 *  - Entre páginas: las columnas toman el color de la sección destino.
 * El estado lo define <html data-splash | data-nav-out | data-nav-in> (ver script en línea de Base.astro).
 */
const ACCENTS = ['#ffc800', '#1cb0f6', '#58cc02', '#ff9600', '#ce82ff'];
---

<div class="ld" aria-hidden="true">
  <div class="ld-cols">{ACCENTS.map((a, i) => <span class="c" style={`--a:${a}; --i:${i}`}><i></i></span>)}</div>
  <div class="ld-center">
    <span class="moon"><span class="disc"></span><span class="bite"></span><span class="spark"></span></span>
    <p class="ld-brand">Liceo Lunita <span>de Chía</span></p>
    <p class="ld-label"><span data-nav-kicker></span> <b data-nav-label></b></p>
  </div>
  <button type="button" class="ld-skip" data-skip-splash>Saltar intro</button>
</div>

<style is:global>
  .ld { --bg: var(--nav-bg, #303296); --acc: var(--nav-accent, #ffc800); position: fixed; inset: 0; z-index: 9999; pointer-events: none; visibility: hidden; }
  html[data-splash] .ld, html[data-nav-out] .ld, html[data-nav-in] .ld { visibility: visible; }
  html[data-splash='1'] .ld { pointer-events: auto; }
  html[data-splash] { --nav-bg: #303296; }

  /* ---------- Columnas: capa de acento + capa principal ---------- */
  .ld-cols { position: absolute; inset: 0; display: grid; grid-template-columns: repeat(5, 1fr); }
  .ld .c { position: relative; }
  .ld .c::before, .ld .c i { content: ''; position: absolute; inset: 0 -1px; transform: translateY(101%); }
  .ld .c::before { background: var(--a); }
  .ld .c i { background: var(--bg); }

  /* Cubriendo al cargar (sin transición) */
  html[data-splash='1'] .ld .c::before, html[data-splash='1'] .ld .c i,
  html[data-nav-in='1'] .ld .c::before, html[data-nav-in='1'] .ld .c i { transform: none; transition: none; }

  /* Entrada desde abajo: primero el color de acento, luego el color de la sección */
  html[data-nav-out] .ld .c::before, html[data-nav-out] .ld .c i { transform: none; transition: transform 0.42s cubic-bezier(0.7, 0, 0.2, 1); }
  html[data-nav-out] .ld .c::before { transition-delay: calc(var(--i) * 40ms); }
  html[data-nav-out] .ld .c i { transition-delay: calc(var(--i) * 40ms + 80ms); }

  /* Salida hacia arriba: se va la capa principal y el acento la sigue (destello de color) */
  html[data-splash='out'] .ld .c::before, html[data-splash='out'] .ld .c i,
  html[data-nav-in='reveal'] .ld .c::before, html[data-nav-in='reveal'] .ld .c i { transform: translateY(-101%); transition: transform 0.55s cubic-bezier(0.7, 0, 0.2, 1); }
  html[data-splash='out'] .ld .c i, html[data-nav-in='reveal'] .ld .c i { transition-delay: calc(var(--i) * 45ms); }
  html[data-splash='out'] .ld .c::before, html[data-nav-in='reveal'] .ld .c::before { transition-delay: calc(var(--i) * 45ms + 110ms); }

  /* ---------- Media luna que se forma como fase lunar ---------- */
  .ld-center { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 1.1rem; color: #fff; text-align: center; }
  .ld .moon { position: relative; width: 64px; height: 64px; border-radius: 50%; overflow: hidden; opacity: 0; transform: scale(0.6); }
  .ld .disc { position: absolute; inset: 0; border-radius: 50%; background: var(--acc); }
  .ld .bite { position: absolute; inset: -2px; border-radius: 50%; background: var(--bg); transform: translateX(110%); }
  .ld .spark { position: absolute; right: 6px; top: 8px; width: 9px; height: 9px; background: var(--acc); clip-path: polygon(50% 0, 62% 38%, 100% 50%, 62% 62%, 50% 100%, 38% 62%, 0 50%, 38% 38%); transform: scale(0); }
  html[data-splash='1'] .ld .moon, html[data-nav-out] .ld .moon, html[data-nav-in='1'] .ld .moon { opacity: 1; transform: none; transition: opacity 0.25s, transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); }
  html[data-nav-out] .ld .moon { transition-delay: 0.3s; }
  html[data-splash='1'] .ld .bite { animation: ld-phase 0.8s 0.25s cubic-bezier(0.22, 1, 0.36, 1) forwards; }
  html[data-nav-out] .ld .bite { animation: ld-phase 0.5s 0.35s cubic-bezier(0.22, 1, 0.36, 1) forwards; }
  html[data-nav-in='1'] .ld .bite { transform: translateX(34%); }
  html[data-splash='1'] .ld .spark { animation: ld-spark 0.4s 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) forwards; }
  html[data-nav-in='1'] .ld .spark { transform: none; }
  @keyframes ld-phase { to { transform: translateX(34%); } }
  @keyframes ld-spark { to { transform: none; } }
  html[data-splash='out'] .ld .moon, html[data-nav-in='reveal'] .ld .moon { opacity: 0; transform: translateY(-14px) scale(0.9); transition: opacity 0.25s, transform 0.35s; }

  /* Nombre del colegio (solo intro) y etiqueta de la sección (entre páginas) */
  .ld-brand, .ld-label { margin: 0; font-family: var(--font); }
  .ld-brand { font-size: clamp(1.3rem, 1rem + 1.6vw, 2rem); font-weight: 900; letter-spacing: -0.02em; display: none; }
  .ld-brand span { color: var(--yellow); }
  html[data-splash] .ld-brand { display: block; opacity: 0; transform: translateY(10px); }
  html[data-splash='1'] .ld-brand { animation: ld-up 0.5s 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards; }
  .ld-label { font-size: 0.8rem; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0; }
  .ld-label span { opacity: 0.7; font-weight: 700; }
  .ld-label b { font-weight: 900; }
  html[data-nav-out] .ld-label { animation: ld-up 0.35s 0.42s ease forwards; }
  html[data-nav-in='1'] .ld-label { opacity: 1; }
  html[data-splash] .ld-label { display: none; }
  @keyframes ld-up { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  html[data-splash='out'] .ld-brand, html[data-nav-in='reveal'] .ld-label { opacity: 0; transition: opacity 0.2s; animation: none; }

  .ld-skip { position: absolute; right: 1.2rem; bottom: 1.2rem; display: none; padding: 0.45rem 0.9rem; border: 1.5px solid rgb(255 255 255 / 0.5); border-radius: 999px; background: transparent; color: #fff; font: 800 0.75rem var(--font); letter-spacing: 0.06em; text-transform: uppercase; }
  html[data-splash='1'] .ld-skip { display: block; }

  @media (prefers-reduced-motion: reduce) { .ld { display: none; } }
</style>

<script>
  const html = document.documentElement;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const labelEl = document.querySelector<HTMLElement>('[data-nav-label]');
  const kickerEl = document.querySelector<HTMLElement>('[data-nav-kicker]');

  type RouteTheme = { re: RegExp; kicker: string; label: string; bg: string; accent: string };
  const ROUTE_THEMES: RouteTheme[] = [
    { re: /^\/admisiones/, kicker: 'Matrículas 2027', label: 'Admisiones', bg: '#303296', accent: '#ffc800' },
    { re: /^\/modelo-stheami/, kicker: 'Modelo', label: 'STHEAMI', bg: '#1899d6', accent: '#ffc800' },
    { re: /^\/niveles/, kicker: 'Aprendizaje', label: 'Niveles', bg: '#46a302', accent: '#ffc800' },
    { re: /^\/festival-de-bandas/, kicker: 'Ciudad de la Luna', label: 'Festival de Bandas', bg: '#a568cc', accent: '#ffc800' },
    { re: /^\/retos-2026/, kicker: 'Camino', label: 'Retos 2026', bg: '#0f1747', accent: '#ffc800' },
    { re: /^\/el-cole/, kicker: 'Identidad', label: 'El Cole', bg: '#303296', accent: '#ffc800' },
    { re: /^\/noticias/, kicker: 'Vida escolar', label: 'Noticias', bg: '#e08600', accent: '#fff' },
    { re: /^\/comunidad/, kicker: 'Familias y docentes', label: 'Comunidad', bg: '#1cb0f6', accent: '#ffc800' },
    { re: /^\/contacto/, kicker: 'Hablemos', label: 'Contacto', bg: '#46a302', accent: '#ffc800' },
    { re: /^\/preguntas-frecuentes/, kicker: 'Ayuda', label: 'Preguntas frecuentes', bg: '#ff9600', accent: '#fff' },
    { re: /^\/$/, kicker: 'Liceo Lunita', label: 'Inicio', bg: '#303296', accent: '#ffc800' },
  ];
  const themeFor = (pathname: string): RouteTheme =>
    ROUTE_THEMES.find((t) => t.re.test(pathname)) ?? { re: /.*/, kicker: 'Liceo Lunita', label: 'de Chía', bg: '#303296', accent: '#ffc800' };

  /* ---------- 1. Intro (primera visita) ---------- */
  if (html.dataset.splash === '1') {
    let done = false;
    const finish = () => {
      if (done) return;
      done = true;
      try { sessionStorage.setItem('lunita-intro-seen', '1'); } catch {}
      html.dataset.splash = 'out';
      setTimeout(() => { delete html.dataset.splash; }, 900);
    };
    const timer = setTimeout(finish, 1500);
    const skip = () => { clearTimeout(timer); finish(); };
    document.querySelector('[data-skip-splash]')?.addEventListener('click', skip);
    document.querySelector('.ld')?.addEventListener('click', skip);
    addEventListener('keydown', (e) => { if (e.key === 'Escape') skip(); }, { once: true });
  }

  /* ---------- 2. Transición entre páginas ---------- */
  const waitReady = (minMs: number, maxMs: number) => {
    const delay = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));
    const loaded = document.readyState === 'complete' ? Promise.resolve() : new Promise<void>((r) => addEventListener('load', () => r(), { once: true }));
    return Promise.all([delay(minMs), Promise.race([loaded, delay(maxMs)])]);
  };

  const revealIncoming = () => {
    if (html.dataset.navIn !== '1') return;
    try {
      const d = JSON.parse(sessionStorage.getItem('lunita-nav') || '{}');
      if (d.label && labelEl) labelEl.textContent = d.label;
      if (d.kicker && kickerEl) kickerEl.textContent = d.kicker;
      sessionStorage.removeItem('lunita-nav');
    } catch {}
    waitReady(180, 800).then(() => {
      if (html.dataset.navIn !== '1') return;
      html.dataset.navIn = 'reveal';
      setTimeout(() => { delete html.dataset.navIn; }, 900);
    });
  };
  revealIncoming();

  addEventListener('pageshow', (e) => {
    if ((e as PageTransitionEvent).persisted) delete html.dataset.navOut;
    revealIncoming();
  });

  if (!reduce) {
    document.addEventListener('click', (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const a = (e.target as Element | null)?.closest('a[href]') as HTMLAnchorElement | null;
      if (!a || (a.target && a.target !== '_self') || a.hasAttribute('download')) return;
      let url: URL;
      try { url = new URL(a.href, location.href); } catch { return; }
      if (url.origin !== location.origin) return;
      if (url.pathname === location.pathname && url.search === location.search) return;
      if (/\.(pdf|ics|mp3|json|xml|txt)$/i.test(url.pathname)) return;

      e.preventDefault();
      const t = themeFor(url.pathname);
      html.style.setProperty('--nav-bg', t.bg);
      html.style.setProperty('--nav-accent', t.accent);
      if (labelEl) labelEl.textContent = t.label;
      if (kickerEl) kickerEl.textContent = t.kicker;
      try { sessionStorage.setItem('lunita-nav', JSON.stringify(t)); } catch {}
      html.dataset.navOut = '1';
      setTimeout(() => { location.href = url.href; }, 620);
    });
  }
</script>
