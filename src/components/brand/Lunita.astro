/**
 * Lunita — mascota oficial del Liceo Lunita de Chía (personaje 2026: elipse azul, media luna y estrella).
 *
 * SVG vectorial redibujado desde NuevaPersonajeSitioweb.psd y animado solo con CSS (sin Rive):
 *   data-anim = intro | idle | hello | hop | party | loading | sleep  (ver assets/personaje-nuevo/animaciones.html)
 *   - idle: la luna se mece y la estrella titila. hello: al pasar el cursor. hop: al hacer clic (o `__lunita.tap()`).
 *   - intro (prop `intro`): se dibuja la elipse y entra la luna cuando se va la pantalla de carga.
 * Accesorios y animación base personalizados por tipo de página con `pose`.
 *
 * pose: 'base' | 'hola' | 'admisiones' | 'estudio' | 'stheami' | 'musica' | 'buscar' | 'espacio' | 'comunidad' | 'contacto' | 'celebra' | 'dormida'
 */
export type LunitaPose =
  | 'base'
  | 'hola'
  | 'admisiones'
  | 'estudio'
  | 'stheami'
  | 'musica'
  | 'buscar'
  | 'espacio'
  | 'comunidad'
  | 'contacto'
  | 'celebra'
  | 'dormida';

interface Props {
  size?: number;
  pose?: LunitaPose;
  /** Entrada animada (hero): se reproduce cuando se va la pantalla de carga */
  intro?: boolean;
  /** Inclina a Lunita suavemente hacia el cursor */
  track?: boolean;
  class?: string;
  label?: string;
  /** Modo escena: renderiza los accesorios de varias poses y se cambian en vivo con data-pose (sin recargar). */
  poses?: LunitaPose[];
}
const { size = 240, pose = 'hola', intro = false, track = true, class: cls = '', label, poses } = Astro.props;
const has = (x: LunitaPose) => (poses ? poses.includes(x) : pose === x);
const base = pose === 'celebra' ? 'party' : pose === 'dormida' ? 'sleep' : 'idle';
const p = `l${Math.random().toString(36).slice(2, 7)}`;
const id = (s: string) => `${p}-${s}`;
const url = (s: string) => `url(#${p}-${s})`;

