---
/**
 * Lunita — mascota oficial del Liceo Lunita de Chía.
 *
 * Capa 1 (siempre): SVG vectorial basado en assets/mascot/lunita-rive.svg, animado con CSS
 *   (flota, parpadea, levanta las cejas, habla al pasar el cursor) y pupilas que siguen el puntero,
 *   con accesorios y animaciones personalizadas por sección.
 * Capa 2 (opcional, prop `rive`): si existe /rive/lunita.riv, carga Rive en segundo plano y
 *   hace crossfade suave SOLO cuando el primer frame dibujado es limpio (sin cuadro negro).
 *
 * pose: 'base' | 'hola' | 'admisiones' | 'estudio' | 'stheami' | 'musica' | 'buscar' | 'espacio' | 'comunidad' | 'contacto' | 'celebra'
 */
export type LunitaPose =
  | 'base'
  | 'hola'
  | 'admisiones'
  | 'estudio'
  | 'stheami'
  | 'musica'
  | 'buscar'
  | 'espacio'
  | 'comunidad'
  | 'contacto'
  | 'celebra';

interface Props {
  size?: number;
  pose?: LunitaPose;
  rive?: boolean;
  /** La entrada la hace Rive (animación Intro); el SVG solo aparece si Rive no está disponible */
  intro?: boolean;
  track?: boolean;
  class?: string;
  label?: string;
  /** Modo escena: renderiza los accesorios de varias poses y se cambian en vivo con data-pose (sin recargar). */
  poses?: LunitaPose[];
}
const { size = 240, pose = 'hola', rive = false, intro = false, track = true, class: cls = '', label, poses } = Astro.props;
const has = (x: LunitaPose) => (poses ? poses.includes(x) : pose === x);
const p = `l${Math.random().toString(36).slice(2, 7)}`;
const id = (s: string) => `${p}-${s}`;
const url = (s: string) => `url(#${p}-${s})`;

const BODY =
  'M565 83C638 81 726 100 730 129C733 149 690 159 648 181C574 218 521 284 520 356C519 446 575 542 666 580C738 610 806 594 861 549C883 531 899 534 900 556C902 606 862 695 802 761C722 848 614 884 505 882C305 879 144 715 144 495C144 268 330 87 565 83Z';
const EYE_L = 'M303 441C350 432 392 473 395 522C398 568 361 599 316 597C271 595 247 557 250 509C253 465 268 448 303 441Z';
const EYE_R = 'M480 398C512 394 541 430 544 475C547 514 526 534 497 532C466 530 448 498 448 458C448 421 459 401 480 398Z';
const MOUTH = 'M389 583C387 573 399 572 415 570C440 566 464 557 481 547C492 541 499 549 500 566C502 609 481 648 448 648C414 648 391 615 389 583Z';
const shades = ['face-light', 'top-concavity', 'top-crest', 'lower-crest', 'lower-undershadow', 'belly-shadow', 'outer-volume'];
const star = (cx: number, cy: number, R: number, r: number) =>
  Array.from({ length: 10 }, (_, i) => {
    const a = ((-90 + i * 36) * Math.PI) / 180, rr = i % 2 ? r : R;
    return `${i ? 'L' : 'M'}${(cx + rr * Math.cos(a)).toFixed(0)} ${(cy + rr * Math.sin(a)).toFixed(0)}`;
  }).join('') + 'Z';
---

<div class:list={['lunita', `lunita--${pose}`, cls]} style={`--s:${size}px`} data-lunita data-scene={poses ? '' : undefined} data-pose={poses ? pose : undefined} data-track={track ? '' : undefined} data-rive={rive ? '' : undefined} data-intro={rive && intro ? '' : undefined} role="img" aria-label={label ?? 'Lunita, la mascota del Liceo Lunita de Chía'}>
  <svg class="lun-svg" viewBox="-60 -60 1120 1120" aria-hidden="true">
    <defs>
      <path id={id('body')} d={BODY} />
      <clipPath id={id('eyeL')}><path d={EYE_L} /></clipPath>
      <clipPath id={id('eyeR')}><path d={EYE_R} /></clipPath>
      <clipPath id={id('mouth')}><path d={MOUTH} /></clipPath>
      <radialGradient id={id('base')} cx="470" cy="365" r="535" fx="495" fy="320" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#FFE95C" /><stop offset=".42" stop-color="#FFD432" /><stop offset=".7" stop-color="#F2AA12" /><stop offset=".9" stop-color="#C97910" /><stop offset="1" stop-color="#B0640E" /></radialGradient>
      <radialGradient id={id('outer-volume')} cx="555" cy="405" r="465" gradientUnits="userSpaceOnUse"><stop offset=".56" stop-color="#B86B10" stop-opacity="0" /><stop offset=".76" stop-color="#C97A12" stop-opacity=".34" /><stop offset=".88" stop-color="#B5660E" stop-opacity=".72" /><stop offset=".96" stop-color="#A65A0D" stop-opacity=".82" /><stop offset="1" stop-color="#CE841C" stop-opacity=".58" /></radialGradient>
      <radialGradient id={id('belly-shadow')} cx="520" cy="895" r="340" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#A95D0D" stop-opacity=".86" /><stop offset=".45" stop-color="#C67610" stop-opacity=".52" /><stop offset=".82" stop-color="#E69B14" stop-opacity=".12" /><stop offset="1" stop-color="#FFD432" stop-opacity="0" /></radialGradient>
      <radialGradient id={id('top-concavity')} cx="628" cy="215" r="225" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#C97208" stop-opacity=".86" /><stop offset=".44" stop-color="#DF8D0E" stop-opacity=".54" /><stop offset=".78" stop-color="#F5B21A" stop-opacity=".12" /><stop offset="1" stop-color="#FFD432" stop-opacity="0" /></radialGradient>
      <radialGradient id={id('top-crest')} cx="625" cy="105" r="220" fx="655" fy="96" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#FFF58A" stop-opacity=".98" /><stop offset=".48" stop-color="#FFE95E" stop-opacity=".58" /><stop offset=".82" stop-color="#FFD73A" stop-opacity=".12" /><stop offset="1" stop-color="#FFD432" stop-opacity="0" /></radialGradient>
      <radialGradient id={id('lower-crest')} cx="775" cy="600" r="215" fx="835" fy="565" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#FFF588" stop-opacity=".95" /><stop offset=".48" stop-color="#FFEA60" stop-opacity=".52" /><stop offset=".82" stop-color="#FFD93E" stop-opacity=".12" /><stop offset="1" stop-color="#FFD432" stop-opacity="0" /></radialGradient>
      <radialGradient id={id('lower-undershadow')} cx="855" cy="760" r="245" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#B0620E" stop-opacity=".86" /><stop offset=".48" stop-color="#CF7E12" stop-opacity=".48" /><stop offset=".82" stop-color="#EB9F16" stop-opacity=".1" /><stop offset="1" stop-color="#FFD432" stop-opacity="0" /></radialGradient>
      <radialGradient id={id('face-light')} cx="430" cy="455" r="215" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#FFEC6B" stop-opacity=".55" /><stop offset=".65" stop-color="#FFDF48" stop-opacity=".22" /><stop offset="1" stop-color="#FFD432" stop-opacity="0" /></radialGradient>
      <radialGradient id={id('scL')} cx="326" cy="492" r="98" fx="332" fy="478" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#fff" /><stop offset=".58" stop-color="#FEF6E6" /><stop offset="1" stop-color="#E9CEAC" /></radialGradient>
      <radialGradient id={id('scR')} cx="496" cy="448" r="82" fx="502" fy="436" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#fff" /><stop offset=".58" stop-color="#FEF6E6" /><stop offset="1" stop-color="#EAD1B2" /></radialGradient>
      <radialGradient id={id('iris')} cx="50%" cy="40%" r="60%"><stop offset="0" stop-color="#45271A" /><stop offset=".45" stop-color="#291712" /><stop offset="1" stop-color="#1E110D" /></radialGradient>
      <linearGradient id={id('cav')} x1="440" y1="546" x2="448" y2="625" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#260A08" /><stop offset="1" stop-color="#4B1712" /></linearGradient>
      <radialGradient id={id('tongue')} cx="452" cy="609" r="52" fx="450" fy="602" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#FD8B78" /><stop offset=".52" stop-color="#E75C4B" /><stop offset="1" stop-color="#C63E31" /></radialGradient>
    </defs>

    <ellipse class="lun-shadow" cx="520" cy="1000" rx="260" ry="34" fill="#0f1747" opacity=".12" />

    <!-- Accesorios traseros / orbitales por sección -->
    {has('stheami') && (<g data-acc="stheami">
      <g class="acc acc-atom" transform="translate(860 220)">
        <circle r="32" fill="#1cb0f6" />
        <g fill="none" stroke="#1899d6" stroke-width="15">
          <ellipse rx="126" ry="44" />
          <ellipse rx="126" ry="44" transform="rotate(60)" />
          <ellipse rx="126" ry="44" transform="rotate(-60)" />
        </g>
        <circle cx="122" cy="0" r="16" fill="#FECA0D" />
      </g></g>
    )}
    {has('espacio') && (<g data-acc="espacio">
      <g class="acc acc-orbit">
        <g transform="translate(890 170) rotate(35)">
          <path d="M0-120C40-80 55-20 40 50L0 90-40 50C-55-20-40-80 0-120Z" fill="#fff" stroke="#1899d6" stroke-width="12" />
          <circle cy="-30" r="24" fill="#1cb0f6" stroke="#1899d6" stroke-width="8" />
          <path d="M-40 40-80 90-30 95M40 40 80 90 30 95" fill="#ff4b4b" stroke="#ea2b2b" stroke-width="8" stroke-linejoin="round" />
          <path class="flame" d="M-22 92Q0 170 0 180Q0 170 22 92Z" fill="#ff9600" />
        </g>
      </g></g>
    )}

    <g class="lun-float">
      <g class="lun-body">
        <use href={`#${id('body')}`} fill={url('base')} />
        {shades.map((s) => <use href={`#${id('body')}`} fill={url(s)} />)}
      </g>

      <g class="lun-face">
        <g class="lun-brows">
          <path d="M248 421C243 418 244 405 252 390C264 370 288 356 309 356C319 356 324 363 321 371C318 378 308 380 295 387C278 396 266 408 257 418C254 422 250 423 248 421Z" fill="#311C15" />
          <path d="M441 343C438 337 443 326 456 325C472 324 487 333 494 347C498 355 495 361 489 359C481 355 471 350 458 349C448 349 443 347 441 343Z" fill="#361E16" />
        </g>
        <path d={EYE_L} fill={url('scL')} />
        <g clip-path={url('eyeL')}>
          <g class="lun-pupil">
            <ellipse cx="356" cy="508" rx="41" ry="60" transform="rotate(-17 356 508)" fill={url('iris')} />
            <ellipse cx="340" cy="480" rx="13" ry="17" transform="rotate(-14 340 480)" fill="#fff" />
          </g>
          <g class="lun-lid lun-lid-l" transform="translate(0 -185)">
            <rect x="235" y="425" width="180" height="175" fill="#FFD639" />
            <path d="M240 596Q324 612 408 588" fill="none" stroke="#311C15" stroke-width="10" stroke-linecap="round" />
          </g>
        </g>
        <path d="M251 532C243 493 255 451 287 438C316 426 350 437 372 459C350 444 320 439 294 448C265 459 253 495 255 532Z" fill="#311C15" />

        <path d={EYE_R} fill={url('scR')} />
        <g clip-path={url('eyeR')}>
          <g class="lun-pupil">
            <ellipse cx="514" cy="464" rx="35.5" ry="58" transform="rotate(-17 514 464)" fill={url('iris')} />
            <ellipse cx="498" cy="436" rx="11" ry="16" transform="rotate(-14 498 436)" fill="#fff" />
          </g>
          <g class="lun-lid lun-lid-r" transform="translate(0 -185)">
            <rect x="435" y="385" width="130" height="155" fill="#FFD639" />
            <path d="M440 536Q496 550 554 528" fill="none" stroke="#311C15" stroke-width="9" stroke-linecap="round" />
          </g>
        </g>
        <path d="M449 474C444 436 454 400 476 393C496 387 519 401 531 422C516 407 497 399 480 404C460 409 451 440 452 474Z" fill="#311C15" />

        <g class="lun-mouth">
          <path d={MOUTH} fill={url('cav')} />
          <g clip-path={url('mouth')}>
            <path d="M405 634C409 605 433 592 459 593C482 594 496 605 496 626C496 645 473 654 447 653C424 652 403 646 405 634Z" fill={url('tongue')} />
          </g>
        </g>

        <!-- Gafas científicas STHEAMI -->
        {has('stheami') && (<g data-acc="stheami">
          <g class="acc acc-glasses" fill="#ddf4ff" fill-opacity=".28" stroke="#313293" stroke-width="18">
            <ellipse cx="322" cy="516" rx="88" ry="92" transform="rotate(-12 322 516)" />
            <ellipse cx="494" cy="466" rx="64" ry="80" transform="rotate(-12 494 466)" />
            <path d="M408 492Q424 476 436 484" fill="none" stroke-linecap="round" />
            <path d="M266 476Q284 456 308 456" fill="none" stroke="#fff" stroke-width="9" stroke-linecap="round" opacity=".8" />
          </g></g>
        )}

        <!-- Visor espacial NASA Space Apps -->
        {has('espacio') && (<g data-acc="espacio">
          <g class="acc acc-visor">
            <path d="M214 438C226 304 452 252 542 356C558 374 536 402 504 396C416 376 296 398 234 450C220 462 212 454 214 438Z" fill="#38bdf8" fill-opacity=".34" stroke="#0284c7" stroke-width="14" stroke-linejoin="round" />
            <path d="M274 358Q352 318 424 328" fill="none" stroke="#fff" stroke-width="14" stroke-linecap="round" opacity=".78" />
          </g></g>
        )}
      </g>

      <!-- Accesorios delanteros personalizados por sección -->
      {has('estudio') && (<g data-acc="estudio">
        <g class="acc acc-cap" transform="rotate(-14 420 155)">
          <path d="M286 155 420 100 564 155 420 212Z" fill="#0f1747" stroke="#313293" stroke-width="8" stroke-linejoin="round" />
          <path d="M336 176V232C378 256 462 256 504 232V176L420 212Z" fill="#313293" />
          <g class="tassel">
            <path d="M560 155V246" stroke="#FECA0D" stroke-width="11" stroke-linecap="round" />
            <circle cx="560" cy="258" r="17" fill="#FECA0D" />
          </g>
        </g></g>
      )}

      {has('musica') && (<g data-acc="musica">
        <g class="acc acc-shako" transform="translate(360 118) rotate(-14)">
          <!-- Gorro de Banda Marcial Ciudad de la Luna -->
          <path d="M-84 62 L-72 -42 C-30 -64 34 -64 76 -42 L88 62 Z" fill="#313293" stroke="#0f1747" stroke-width="10" stroke-linejoin="round" />
          <path d="M-96 62 C-36 86 42 86 104 62 L92 86 C34 106 -34 106 -86 86 Z" fill="#0f1747" />
          <path d="M-76 32 Q2 52 80 32 L83 52 Q2 72 -79 52 Z" fill="#FECA0D" />
          <path d={star(2, 4, 24, 9)} fill="#FECA0D" stroke="#0f1747" stroke-width="4" />
          <!-- Penacho blanco y dorado animado -->
          <g class="plume">
            <path d="M2 -48 C-26 -110 -12 -154 2 -164 C18 -154 32 -110 2 -48 Z" fill="#fff" stroke="#FECA0D" stroke-width="9" />
            <path d="M2 -54 C-10 -96 -4 -128 2 -138 C10 -128 16 -96 2 -54 Z" fill="#FECA0D" opacity=".75" />
          </g>
        </g></g>
      )}

      {has('admisiones') && (<g data-acc="admisiones">
        <g transform="translate(745 690) rotate(8)"><g class="acc acc-folder">
          <rect x="-92" y="-70" width="184" height="148" rx="22" fill="#313293" stroke="#0f1747" stroke-width="11" />
          <path d="M-92 -42 L-92 -76 C-92 -88 -82 -96 -70 -96 L-8 -96 L12 -70 Z" fill="#FECA0D" stroke="#0f1747" stroke-width="10" stroke-linejoin="round" />
          <rect x="-66" y="-36" width="132" height="90" rx="12" fill="#fff" />
          <path d="M-36 10 L-8 36 L44 -14" fill="none" stroke="#58cc02" stroke-width="18" stroke-linecap="round" stroke-linejoin="round" />
        </g></g></g>
      )}

      {has('comunidad') && (<g data-acc="comunidad">
        <g transform="translate(760 695) rotate(-8)"><g class="acc acc-tablet">
          <rect x="-96" y="-76" width="192" height="144" rx="24" fill="#0f1747" stroke="#313293" stroke-width="10" />
          <rect x="-76" y="-56" width="152" height="104" rx="12" fill="#ddf4ff" />
          <rect x="-56" y="-36" width="76" height="16" rx="8" fill="#1cb0f6" />
          <rect x="-56" y="-8" width="112" height="12" rx="6" fill="#313293" opacity=".35" />
          <rect x="-56" y="16" width="84" height="12" rx="6" fill="#313293" opacity=".35" />
          <circle cx="48" cy="-28" r="14" fill="#FECA0D" />
        </g></g></g>
      )}

      {has('contacto') && (<g data-acc="contacto">
        <g transform="translate(770 675) rotate(-10)"><g class="acc acc-mail">
          <rect x="-96" y="-66" width="192" height="132" rx="22" fill="#fff" stroke="#313293" stroke-width="12" />
          <path d="M-88 -54 L0 16 L88 -54" fill="none" stroke="#313293" stroke-width="12" stroke-linecap="round" stroke-linejoin="round" />
          <circle cx="0" cy="14" r="24" fill="#FECA0D" stroke="#313293" stroke-width="8" />
          <path d={star(0, 14, 13, 5)} fill="#313293" />
        </g></g></g>
      )}

      {has('buscar') && (<g data-acc="buscar">
        <g class="acc acc-lens">
          <circle cx="710" cy="750" r="78" fill="#ddf4ff" fill-opacity=".86" stroke="#1899d6" stroke-width="22" />
          <path d="M766 806 850 890" stroke="#1899d6" stroke-width="30" stroke-linecap="round" />
          <path d="M670 720Q690 702 714 702" stroke="#fff" stroke-width="12" stroke-linecap="round" fill="none" />
        </g></g>
      )}

      {has('celebra') && (<g data-acc="celebra">
        <g transform="translate(755 710) rotate(12)"><g class="acc acc-medal">
          <circle r="66" fill="#FECA0D" stroke="#313293" stroke-width="12" />
          <text x="0" y="20" text-anchor="middle" font-family="Nunito, system-ui, sans-serif" font-weight="900" font-size="60" fill="#313293">A+</text>
        </g></g></g>
      )}
    </g>

    <!-- Chispas y partículas ambientales por pose -->
    {(has('hola') || has('celebra') || has('admisiones')) && (
      <g data-acc="hola celebra admisiones"><g class="acc acc-sparks">
        <path d={star(910, 120, 44, 18)} fill="#FECA0D" stroke="#e5a400" stroke-width="9" stroke-linejoin="round" />
        <path d="M80 200l14 34 34 14-34 14-14 34-14-34-34-14 34-14z" fill="#1cb0f6" />
        <path d="M950 760l10 24 24 10-24 10-10 24-10-24-24-10 24-10z" fill="#ce82ff" />
      </g></g>
    )}
    {has('celebra') && (<g data-acc="celebra">
      <g class="acc acc-confetti">
        <rect x="120" y="60" width="26" height="14" rx="4" fill="#ff4b4b" transform="rotate(30 133 67)" />
        <rect x="800" y="40" width="26" height="14" rx="4" fill="#58cc02" transform="rotate(-20 813 47)" />
        <circle cx="970" cy="420" r="12" fill="#ff9600" />
        <circle cx="60" cy="620" r="12" fill="#58cc02" />
        <rect x="700" y="0" width="22" height="12" rx="4" fill="#1cb0f6" />
      </g></g>
    )}
    {has('musica') && (<g data-acc="musica">
      <g class="acc acc-notes" fill="#ce82ff">
        <path d="M900 180v150a40 34 0 1 1-24-30V210l-90 20v130a40 34 0 1 1-24-30V190z" />
        <path d="M100 320v90a30 26 0 1 1-18-24V320z" fill="#1cb0f6" />
      </g></g>
    )}
  </svg>
  {rive && <canvas class="lun-rive" aria-hidden="true" hidden></canvas>}
</div>

<style is:global>
  .lunita { position: relative; width: var(--s); max-width: 100%; aspect-ratio: 1120 / 1120; flex: none; -webkit-tap-highlight-color: transparent; }
  .lunita .lun-svg, .lunita .lun-rive { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  /* Crossfade limpio: el canvas Rive permanece invisible hasta verificar el primer frame transparente */
  .lunita .lun-svg { opacity: 1; transition: opacity 0.28s ease-out; }
  .lunita .lun-rive { opacity: 0; pointer-events: none; transition: opacity 0.28s ease-out; }
  .lunita[data-rive-ready] .lun-svg { opacity: 0; pointer-events: none; }
  .lunita[data-rive-ready] .lun-rive { opacity: 1; pointer-events: auto; }
  /* Con intro: nada visible hasta que Rive arranca su entrada; si Rive falla, el SVG entra con un pop */
  .js .lunita[data-intro]:not([data-rive-ready]):not([data-rive-fail]) .lun-svg { opacity: 0; transition: none; }
  .lunita[data-intro][data-rive-ready] .lun-rive { transition-duration: 0.12s; }
  /* Entrada del SVG (móvil o sin Rive): misma coreografía que la Intro de Rive — pop girando, rebote y saltito */
  .lunita[data-intro][data-rive-fail]:not([data-rive-ready]) .lun-svg { transform-origin: 50% 85%; animation: lun-intro 1.4s linear both; }
  @keyframes lun-intro {
    0% { opacity: 0; transform: scale(0) rotate(-45deg); animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1); }
    8% { opacity: 1; }
    24% { transform: scale(1.12) rotate(10deg); animation-timing-function: ease-in-out; }
    36% { transform: scale(0.94) rotate(-4deg); animation-timing-function: ease-in-out; }
    46% { transform: scale(1) rotate(0); }
    54% { transform: scale(1.06, 0.92); animation-timing-function: cubic-bezier(0.2, 0.6, 0.35, 1); }
    66% { transform: translateY(-12%) scale(0.95, 1.06); animation-timing-function: cubic-bezier(0.6, 0, 0.8, 0.4); }
    76% { transform: scale(1.08, 0.9); animation-timing-function: ease-in-out; }
    86%, 100% { opacity: 1; transform: none; }
  }

  .lunita .lun-float { transform-origin: 520px 880px; }
  /* Modo escena: solo se ven los accesorios de la pose activa; entran y salen con escala */
  .lunita[data-scene] [data-acc] { opacity: 0; transform: scale(0.4); transform-box: fill-box; transform-origin: center; transition: opacity 0.3s ease, transform 0.45s cubic-bezier(.34, 1.56, .64, 1); }
  .lunita[data-scene][data-pose='hola'] [data-acc~='hola'], .lunita[data-scene][data-pose='stheami'] [data-acc~='stheami'], .lunita[data-scene][data-pose='espacio'] [data-acc~='espacio'],
  .lunita[data-scene][data-pose='musica'] [data-acc~='musica'], .lunita[data-scene][data-pose='estudio'] [data-acc~='estudio'], .lunita[data-scene][data-pose='celebra'] [data-acc~='celebra'],
  .lunita[data-scene][data-pose='admisiones'] [data-acc~='admisiones'] { opacity: 1; transform: none; }
  .lunita .lun-body { transform-origin: 500px 500px; transform: rotate(var(--tilt, 0deg)); }
  .lunita .lun-face { transform: translate(var(--fx, 0px), var(--fy, 0px)); }
  .lunita .lun-shadow { transform-origin: 520px 1000px; }
  .lunita .lun-lid { transform: translateY(-185px); transition: transform 0.11s cubic-bezier(0.4, 0, 0.2, 1); }
  .lunita.is-blink .lun-lid { transform: translateY(0px); }
  .lunita .lun-pupil { transform: translate(var(--px, 0px), var(--py, 0px)); }
  .lunita .lun-brows { transition: transform 0.28s cubic-bezier(.34, 1.56, .64, 1); }
