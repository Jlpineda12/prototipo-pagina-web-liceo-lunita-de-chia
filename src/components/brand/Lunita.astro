<div class:list={['lunita', `lunita--${pose}`, cls]} style={`--s:${size}px`} data-lunita data-base={base} data-scene={poses ? '' : undefined} data-pose={poses ? pose : undefined} data-track={track ? '' : undefined} data-intro={intro ? '' : undefined} role="img" aria-label={label ?? 'Lunita, la mascota del Liceo Lunita de Chía'}>
  <svg class="lun-svg" viewBox="-130 -60 700 700" data-anim={base} style={`--clip:${url('win')}`} aria-hidden="true">
    <defs>
      <mask id={id('draw')} maskUnits="userSpaceOnUse" x="-40" y="-40" width="520" height="660"><path class="lc-trace" pathLength="1" d={TRACE} /></mask>
      <clipPath id={id('win')}><path d={PLATE} /></clipPath>
      <linearGradient id={id('trail')} gradientUnits="userSpaceOnUse" x1="0" y1="-270" x2="-200" y2="-180"><stop offset="0" stop-color="#ffc800" /><stop offset="1" stop-color="#ffc800" stop-opacity="0" /></linearGradient>
    </defs>

    <ellipse class="lc-shadow" cx="220" cy="618" rx="150" ry="16" fill="#0f1747" opacity=".1" />

    <!-- ===== Detrás del personaje: escenas por tipo de página ===== -->
    {/* STHEAMI: siete planetas (uno por área) orbitan la elipse */}
    {has('stheami') && (<g data-acc="stheami"><g transform="translate(220 290) scale(1 1.28)"><g class="acc acc-sat">
      <circle r="262" fill="none" stroke="#3047d9" stroke-opacity=".22" stroke-width="3" stroke-dasharray="6 14" vector-effect="non-scaling-stroke" />
      {SEVEN.map((c, i) => <circle cx={(262 * Math.cos((i / 7) * 2 * Math.PI)).toFixed(1)} cy={(262 * Math.sin((i / 7) * 2 * Math.PI)).toFixed(1)} r="12" fill={c} />)}
    </g></g></g>)}
    {/* Retos / espacio: una estrella fugaz da la vuelta a la elipse */}
    {has('espacio') && (<g data-acc="espacio"><g transform="translate(220 290) scale(1 1.25)"><g class="acc acc-comet">
      <circle r="270" fill="none" />
      <path d="M0-270A270 270 0 0 0-191-191" fill="none" stroke={url('trail')} stroke-width="9" stroke-linecap="round" vector-effect="non-scaling-stroke" />
      <path d={star(0, -270, 22, 9)} fill="#ffc800" stroke="#e5a400" stroke-width="4" stroke-linejoin="round" />
    </g></g></g>)}
    {/* Comunidad: una constelación une a todos alrededor de Lunita */}
    {has('comunidad') && (<g data-acc="comunidad"><g class="acc acc-const">
      <path class="const-line" pathLength="1" d="M-60 430L-92 150L60-34L440 26L512 190L500 462" />
      {CONST.map(([x, y, c], i) => <path class="const-dot" style={`--i:${i}`} fill={c} d={star(x, y, i % 2 ? 15 : 19, i % 2 ? 6 : 8)} />)}
    </g></g>)}
    {/* Música: ondas de sonido a ambos lados, al ritmo de la marcha */}
    {has('musica') && (<g data-acc="musica"><g class="acc acc-waves">
      {[0, 1, 2].map((i) => <path class="wave" style={`--i:${i}`} stroke={i === 1 ? '#1cb0f6' : '#ce82ff'} d={`M${462 + i * 34} ${222 - i * 22}Q${500 + i * 44} 290 ${462 + i * 34} ${358 + i * 22}`} />)}
      {[0, 1, 2].map((i) => <path class="wave" style={`--i:${i}`} stroke={i === 1 ? '#1cb0f6' : '#ce82ff'} d={`M${-22 - i * 34} ${222 - i * 22}Q${-60 - i * 44} 290 ${-22 - i * 34} ${358 + i * 22}`} />)}
    </g></g>)}

    <g class="lc-look">
      <g class="lc-body">
        {/* Buscar: la elipse se vuelve lupa con su mango */}
        {has('buscar') && (<g data-acc="buscar">
          <path d="M380 500L462 612" stroke="#0f1747" stroke-width="40" stroke-linecap="round" />
          <path d="M378 497L398 524" stroke="#ffc800" stroke-width="46" stroke-linecap="round" />
        </g>)}
        <path class="lc-plate" d={PLATE} />
        <g mask={url('draw')}><path class="lc-ring" d={RING} /></g>
        {/* Admisiones: estrellitas de colores llegan al abrazo de la luna (la familia crece) */}
        {has('admisiones') && (<g data-acc="admisiones"><g class="acc acc-family">
          {FAMILY.map(([x, y, c, fx, fy], i) => <path class="fam" style={`--i:${i};--fx:${fx}px;--fy:${fy}px`} fill={c} d={star(x, y, 18, 7.5)} />)}
        </g></g>)}
        {/* Aprendizaje: barras que crecen dentro de la luna (de preescolar a once) */}
        {has('estudio') && (<g data-acc="estudio"><g class="acc acc-grow">
          {[['#58cc02', 280, 46], ['#1cb0f6', 322, 78], ['#ce82ff', 364, 112]].map(([c, x, h], i) => <rect class="bar" style={`--i:${i}`} x={Number(x) - 15} y={430 - Number(h)} width="30" height={h} rx="10" fill={c as string} />)}
        </g></g>)}
        <g class="lc-win"><g class="lc-moon"><path fill="#ffc80d" d={MOON} /><path class="lc-shade" fill="#ff9c02" d={SHADE} /></g></g>
        {/* Contacto: la estrella emite señales, como un mensaje que sale */}
        {has('contacto') && (<g data-acc="contacto"><g class="acc acc-ping">
          {[0, 1, 2].map((i) => <circle class="ripple" style={`--i:${i}`} cx="299.5" cy="125.8" r="30" />)}
        </g></g>)}
        <g class="lc-star"><path fill="#ffc80d" d={STAR} /><path fill="#ff9c02" d={SSHADE} /></g>
      </g>
    </g>

    <!-- Chispas ambientales -->
    {(has('hola') || has('celebra')) && (
      <g data-acc="hola celebra"><g class="acc acc-sparks">
        <path d="M500 46l10 24 24 10-24 10-10 24-10-24-24-10 24-10z" fill="#ffc800" />
        <path d="M-80 130l10 24 24 10-24 10-10 24-10-24-24-10 24-10z" fill="#1cb0f6" />
        <path d="M-66 470l8 18 18 8-18 8-8 18-8-18-18-8 18-8z" fill="#ce82ff" />
      </g></g>
    )}
    {has('celebra') && (<g data-acc="celebra">
      <g class="acc acc-confetti">
        <rect x="-96" y="10" width="22" height="12" rx="4" fill="#ff4b4b" transform="rotate(30 -85 16)" />
        <rect x="400" y="-36" width="22" height="12" rx="4" fill="#58cc02" transform="rotate(-20 411 -30)" />
        <circle cx="540" cy="300" r="10" fill="#ff9600" />
        <circle cx="-104" cy="350" r="10" fill="#58cc02" />
        <rect x="80" y="-50" width="20" height="11" rx="4" fill="#1cb0f6" />
      </g></g>
    )}

    <!-- Efectos de las animaciones: destellos (celebración / entrada) y "z" (dormida) -->
    <g transform="translate(220 290)">{BURST.map((b) => <path class="lc-spark" style={`--a:${b.a}deg;--r:${b.r};--c:${b.c};--i:${b.i}`} d={SPARK} />)}</g>
    {has('dormida') && (<g>{[[350, 96, 48, 0], [384, 64, 62, 1.2], [424, 26, 78, 2.4]].map(([x, y, s, d]) => <text class="lc-z" x={x} y={y} style={`font-size:${s}px;--d:${d}s`}>z</text>)}</g>)}
  </svg>
</div>

<style is:global>
  .lunita { position: relative; width: var(--s); max-width: 100%; aspect-ratio: 1; flex: none; -webkit-tap-highlight-color: transparent; }
  .lunita .lun-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .lunita .lun-svg * { transform-box: view-box; }
  .lunita .lc-plate { fill: var(--lun-plate, #fff); transition: fill 0.6s ease; }
  .lunita .lc-ring { fill: #3047d9; }
  .lunita .lc-trace { fill: none; stroke: #fff; stroke-width: 56; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1 1; stroke-dashoffset: 0; }
  .lunita .lc-spark { fill: var(--c); opacity: 0; transform-box: fill-box; transform-origin: center; }
  .lunita .const-line { fill: none; stroke: #3047d9; stroke-opacity: .32; stroke-width: 5; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1 1; }
  .lunita .wave { fill: none; stroke-width: 11; stroke-linecap: round; opacity: 0; }
  .lunita .lc-z { fill: #3047d9; font-family: Nunito, system-ui, sans-serif; font-weight: 900; opacity: 0; transform-box: fill-box; transform-origin: center; }
  /* Pivotes en coordenadas del dibujo (440×580) */
  .lunita .lc-look { transform-origin: 220px 576px; transform: rotate(var(--tilt, 0deg)); transition: transform 0.5s cubic-bezier(.34, 1.56, .64, 1); }
  .lunita .lc-body { transform-origin: 220px 576px; }
  .lunita .lc-plate { transform-origin: 220px 290px; }
  .lunita .lc-moon { transform-origin: 184px 320px; }
  .lunita .lc-star { transform-origin: 299.5px 125.8px; }
  .lunita .lc-shadow { transform-origin: 220px 618px; }
  .js .lunita[data-intro]:not([data-played]) .lun-svg { opacity: 0; }
  .lunita[data-intro] .lun-svg[data-anim='intro'] [data-acc] { animation: lun-acc-in 0.6s 1.3s cubic-bezier(.34, 1.56, .64, 1) both; }
  @keyframes lun-acc-in { from { opacity: 0; } }
  .lunita[data-off] .lun-svg * { animation-play-state: paused !important; }

  /* Modo escena: solo se ven los accesorios de la pose activa; entran y salen con escala */
  .lunita[data-scene] [data-acc] { opacity: 0; transform: scale(0.4); transform-box: fill-box; transform-origin: center; transition: opacity 0.3s ease, transform 0.45s cubic-bezier(.34, 1.56, .64, 1); }
  .lunita[data-scene][data-pose='hola'] [data-acc~='hola'], .lunita[data-scene][data-pose='stheami'] [data-acc~='stheami'], .lunita[data-scene][data-pose='espacio'] [data-acc~='espacio'],
  .lunita[data-scene][data-pose='musica'] [data-acc~='musica'], .lunita[data-scene][data-pose='estudio'] [data-acc~='estudio'], .lunita[data-scene][data-pose='celebra'] [data-acc~='celebra'],
  .lunita[data-scene][data-pose='admisiones'] [data-acc~='admisiones'] { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: no-preference) {
    /* 1. Entrada: la elipse se dibuja, la luna llega girando, la estrella salta y brilla */
    .lunita [data-anim='intro'] .lc-plate { animation: lc-plate-in .55s cubic-bezier(.34, 1.56, .64, 1) both; }
    .lunita [data-anim='intro'] .lc-trace { animation: lc-draw 1.1s .15s cubic-bezier(.65, 0, .35, 1) both; }
    .lunita [data-anim='intro'] .lc-moon { transform-origin: 220px 290px; animation: lc-moon-in 1s .5s cubic-bezier(.3, 1.35, .5, 1) both; }
    .lunita [data-anim='intro'] .lc-shade { animation: lc-shade-in .6s 1.15s ease-out both; }
    .lunita [data-anim='intro'] .lc-star { animation: lc-star-in .7s 1.25s cubic-bezier(.34, 1.8, .64, 1) both; }
    .lunita [data-anim='intro'] .lc-spark { animation: lc-burst .9s calc(1.45s + var(--i) * 30ms) ease-out both; }
    .lunita [data-anim='intro'] .lc-shadow { animation: lc-plate-in .8s .3s ease-out both; }

    /* 2. Reposo: la luna se mece suave y la estrella titila de vez en cuando */
    .lunita [data-anim='idle'] .lc-moon { animation: lc-rock 5s ease-in-out infinite; }
    .lunita [data-anim='idle'] .lc-star { animation: lc-twinkle 3.4s ease-in-out infinite; }

    /* 3. Saludo (cursor encima): la luna asiente y la estrella da un saltito */
    .lunita [data-anim='hello'] .lc-body { animation: lc-lean 1.2s ease-in-out both; }
    .lunita [data-anim='hello'] .lc-moon { animation: lc-nod 1.2s cubic-bezier(.36, 0, .3, 1) both; }
    .lunita [data-anim='hello'] .lc-star { animation: lc-star-hop 1s .1s cubic-bezier(.34, 1.4, .64, 1) both; }

    /* 4. Salto (clic): se agacha, salta y aterriza con rebote; la estrella gira */
    .lunita [data-anim='hop'] .lc-body { animation: lc-hop .95s both; }
    .lunita [data-anim='hop'] .lc-moon { animation: lc-lag .95s ease-in-out both; }
    .lunita [data-anim='hop'] .lc-star { animation: lc-spin .9s .1s cubic-bezier(.5, 0, .3, 1) both; }
    .lunita [data-anim='hop'] .lc-shadow { animation: lc-shadow-hop .95s both; }

    /* 5. Celebración (bucle): la luna da una vuelta completa dentro de la elipse y salen destellos */
    .lunita [data-anim='party'] .lc-win, .lunita [data-anim='loading'] .lc-win { clip-path: var(--clip); }
    .lunita [data-anim='party'] .lc-moon { transform-origin: 220px 290px; animation: lc-orbit 2.6s cubic-bezier(.7, 0, .3, 1) infinite; }
    .lunita [data-anim='party'] .lc-star { animation: lc-party-star 2.6s ease-in-out infinite; }
    .lunita [data-anim='party'] .lc-body { animation: lc-party-body 2.6s infinite; }
    .lunita [data-anim='party'] .lc-spark { animation: lc-burst-loop 2.6s calc(var(--i) * 30ms) ease-out infinite; }

    /* 6. Cargando (bucle): la elipse se dibuja y se borra mientras la luna orbita */
    .lunita [data-anim='loading'] .lc-trace { animation: lc-chase 2.4s cubic-bezier(.65, 0, .35, 1) infinite; }
    .lunita [data-anim='loading'] .lc-moon { transform-origin: 220px 290px; animation: lc-orbit-loop 2.4s cubic-bezier(.45, .05, .55, .95) infinite; }
    .lunita [data-anim='loading'] .lc-star { animation: lc-blink 1.2s ease-in-out infinite; }

    /* 7. Dormida (bucle): la luna se inclina y respira, la estrella se apaga y salen "z" */
    .lunita [data-anim='sleep'] .lc-moon { animation: lc-doze 1.2s ease-in-out both, lc-breathe 4s 1.2s ease-in-out infinite; }
    .lunita [data-anim='sleep'] .lc-star { animation: lc-dim 1.2s ease-in-out both, lc-star-sleep 4s 1.2s ease-in-out infinite; }
    .lunita [data-anim='sleep'] .lc-z { animation: lc-z 3.6s calc(1s + var(--d)) ease-out infinite; }

    /* ===== Escenas por tipo de página ===== */
    .lunita .acc-sparks path, .lunita .acc-confetti > * { transform-box: fill-box; transform-origin: center; animation: lun-twinkle 2.2s ease-in-out infinite; }
    .lunita .acc-sparks path:nth-child(2), .lunita .acc-confetti > :nth-child(even) { animation-delay: -1.1s; }
    /* STHEAMI: órbita lenta */
    .lunita .acc-sat { transform-box: fill-box; transform-origin: center; animation: lun-spin 26s linear infinite; }
    /* Espacio: estrella fugaz que acelera y frena */
    .lunita .acc-comet { transform-box: fill-box; transform-origin: center; animation: lun-spin 5.5s cubic-bezier(.55, .05, .45, .95) infinite; }
    /* Comunidad: la constelación se dibuja, brilla y se desvanece */
    .lunita .const-line { animation: lun-const 7s ease-in-out infinite; }
    .lunita .const-dot { transform-box: fill-box; transform-origin: center; animation: lun-dot 7s calc(var(--i) * 0.28s) ease-out infinite; }
    /* Música: marcha y ondas al compás */
    .lunita--musica [data-anim='idle'] .lc-body { animation: lun-march 1.6s ease-in-out infinite; }
    .lunita--musica [data-anim='idle'] .lc-star { animation: lun-beat 0.8s ease-out infinite; }
    .lunita .wave { transform-box: fill-box; transform-origin: center; animation: lun-wave 1.6s calc(var(--i) * 0.16s) ease-out infinite; }
    /* Buscar: la lupa explora y la luna se asoma */
    .lunita--buscar [data-anim='idle'] .lc-body { animation: lun-explore 4.4s ease-in-out infinite; }
    .lunita--buscar [data-anim='idle'] .lc-win { clip-path: var(--clip); }
    .lunita--buscar [data-anim='idle'] .lc-moon { animation: lun-peek 4.4s ease-in-out infinite; }
    /* Admisiones: llegan estrellitas de colores */
    .lunita .fam { transform-box: fill-box; transform-origin: center; animation: lun-join 5s calc(var(--i) * 0.3s) cubic-bezier(.34, 1.3, .64, 1) infinite; }
    /* Aprendizaje: las barras crecen una tras otra y la estrella celebra */
    .lunita .bar { transform-box: fill-box; transform-origin: bottom; animation: lun-grow 4.5s calc(var(--i) * 0.35s) cubic-bezier(.34, 1.56, .64, 1) infinite; }
    .lunita--estudio [data-anim='idle'] .lc-star { animation: lun-reach 4.5s ease-in-out infinite; }
    /* Contacto: ondas de señal desde la estrella */
    .lunita .ripple { fill: none; stroke: #1cb0f6; stroke-width: 5; transform-box: fill-box; transform-origin: center; animation: lun-ripple 2.4s calc(var(--i) * 0.8s) ease-out infinite; }
    .lunita--contacto [data-anim='idle'] .lc-star { animation: lun-ping 2.4s ease-in-out infinite; }
  }

  @keyframes lc-plate-in { from { transform: scale(.3); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes lc-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes lc-moon-in { from { transform: rotate(-150deg) scale(.15); opacity: 0; } 30% { opacity: 1; } to { transform: none; opacity: 1; } }
  @keyframes lc-shade-in { from { opacity: 0; transform: translate(-16px, 4px); } to { opacity: 1; transform: none; } }
  @keyframes lc-star-in { from { transform: scale(0) rotate(-200deg); } to { transform: none; } }
  @keyframes lc-burst {
    0% { opacity: 0; transform: rotate(var(--a)) translateY(calc(var(--r) * -0.85px)) scale(0); }
    30% { opacity: 1; transform: rotate(var(--a)) translateY(calc(var(--r) * -1px - 30px)) scale(1.1); }
    100% { opacity: 0; transform: rotate(var(--a)) translateY(calc(var(--r) * -1px - 70px)) scale(0); }
  }
  @keyframes lc-rock { 0%, 100% { transform: rotate(-3deg) translateY(3px); } 50% { transform: rotate(3deg) translateY(-5px); } }
  @keyframes lc-twinkle { 0%, 62%, 100% { transform: none; } 72% { transform: scale(.7) rotate(25deg); } 84% { transform: scale(1.22) rotate(-12deg); } 92% { transform: scale(.96) rotate(4deg); } }
  @keyframes lc-lean { 0%, 100% { transform: none; } 25% { transform: rotate(-3deg); } 55% { transform: rotate(2deg); } 80% { transform: rotate(-1deg); } }
  @keyframes lc-nod { 0%, 100% { transform: none; } 18% { transform: rotate(-14deg) translate(-6px, -4px); } 40% { transform: rotate(10deg); } 60% { transform: rotate(-6deg); } 78% { transform: rotate(3deg); } }
  @keyframes lc-star-hop { 0%, 100% { transform: none; } 30% { transform: translateY(-26px) rotate(-30deg) scale(1.15); } 55% { transform: rotate(10deg) scale(.9, 1.05); } 75% { transform: translateY(-8px); } }
  @keyframes lc-hop {
    0% { transform: none; animation-timing-function: ease-out; }
    14% { transform: scale(1.08, .9); animation-timing-function: cubic-bezier(.2, .7, .3, 1); }
    42% { transform: translateY(-70px) scale(.95, 1.06); animation-timing-function: cubic-bezier(.6, 0, .9, .4); }
    64% { transform: scale(1.08, .9); animation-timing-function: ease-out; }
    80% { transform: scale(.98, 1.03); }
    100% { transform: none; }
  }
  @keyframes lc-shadow-hop { 0%, 100% { transform: none; } 42% { transform: scale(.7); opacity: .05; } 64% { transform: scale(1.08); } }
  @keyframes lc-lag { 0%, 100% { transform: none; } 42% { transform: translateY(10px) rotate(-5deg); } 66% { transform: translateY(-8px) rotate(3deg); } }
  @keyframes lc-spin { from { transform: none; } 50% { transform: rotate(200deg) scale(1.25); } to { transform: rotate(360deg); } }
  @keyframes lc-orbit { 0%, 12% { transform: none; } 66%, 100% { transform: rotate(360deg); } }
  @keyframes lc-party-star { 0%, 40%, 100% { transform: none; } 20% { transform: translateY(-20px) rotate(-20deg) scale(1.3); } 72% { transform: translateY(-14px) rotate(15deg) scale(1.2); } 86% { transform: none; } }
  @keyframes lc-party-body { 0%, 60%, 100% { transform: none; } 67% { transform: scale(1.05, .95); } 76% { transform: translateY(-26px) scale(.97, 1.03); } 86% { transform: scale(1.03, .97); } 93% { transform: none; } }
  @keyframes lc-burst-loop {
    0%, 64% { opacity: 0; transform: rotate(var(--a)) translateY(calc(var(--r) * -0.85px)) scale(0); }
    74% { opacity: 1; transform: rotate(var(--a)) translateY(calc(var(--r) * -1px - 30px)) scale(1.1); }
    96%, 100% { opacity: 0; transform: rotate(var(--a)) translateY(calc(var(--r) * -1px - 70px)) scale(0); }
  }
  @keyframes lc-chase { 0% { stroke-dashoffset: 1; } 45%, 55% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: -1; } }
  @keyframes lc-orbit-loop { from { transform: none; } to { transform: rotate(360deg); } }
  @keyframes lc-blink { 0%, 100% { transform: none; opacity: 1; } 50% { transform: scale(.65) rotate(30deg); opacity: .45; } }
  @keyframes lc-doze { from { transform: none; } to { transform: rotate(14deg) translateY(10px); } }
  @keyframes lc-breathe { 0%, 100% { transform: rotate(14deg) translateY(10px); } 50% { transform: rotate(17deg) translateY(14px) scale(1.025); } }
  @keyframes lc-dim { from { opacity: 1; } to { opacity: .4; } }
  @keyframes lc-star-sleep { 0%, 100% { opacity: .4; transform: none; } 50% { opacity: .6; transform: translateY(-6px); } }
  @keyframes lc-z { 0% { opacity: 0; transform: translate(0, 0) scale(.6); } 20% { opacity: 1; } 100% { opacity: 0; transform: translate(36px, -80px) scale(1.2); } }
  @keyframes lun-march { 0%, 100% { transform: translateY(0) rotate(-3deg); } 50% { transform: translateY(-16px) rotate(3deg); } }
  @keyframes lun-beat { 0% { transform: scale(1.25); } 40%, 100% { transform: none; } }
  @keyframes lun-wave { 0% { opacity: 0; transform: scale(.7); } 30% { opacity: 1; } 100% { opacity: 0; transform: scale(1.15); } }
  @keyframes lun-twinkle { 0%, 100% { transform: scale(0.6) rotate(0); opacity: 0.5; } 50% { transform: scale(1.15) rotate(20deg); opacity: 1; } }
  @keyframes lun-spin { to { transform: rotate(360deg); } }
  @keyframes lun-const { 0% { stroke-dashoffset: 1; opacity: 1; } 35%, 80% { stroke-dashoffset: 0; opacity: 1; } 92%, 100% { stroke-dashoffset: 0; opacity: 0; } }
  @keyframes lun-dot { 0% { transform: scale(0); opacity: 0; } 6% { transform: scale(1.35); opacity: 1; } 11%, 80% { transform: none; opacity: 1; } 92%, 100% { transform: scale(0); opacity: 0; } }
  @keyframes lun-explore { 0%, 100% { transform: translate(0, 0) rotate(0); } 30% { transform: translate(-18px, -10px) rotate(-6deg); } 65% { transform: translate(14px, 4px) rotate(5deg); } }
  @keyframes lun-peek { 0%, 100% { transform: none; } 30% { transform: translateX(-44px) rotate(-6deg); } 50% { transform: none; } 65% { transform: translateX(22px) rotate(5deg); } 82% { transform: none; } }
  @keyframes lun-join { 0% { transform: translate(var(--fx), var(--fy)) scale(0) rotate(-200deg); opacity: 0; } 18% { opacity: 1; } 26% { transform: none; } 32% { transform: scale(1.2); } 38%, 82% { transform: none; opacity: 1; } 94%, 100% { transform: scale(0); opacity: 0; } }
  @keyframes lun-grow { 0% { transform: scaleY(0); } 14%, 80% { transform: none; } 92%, 100% { transform: scaleY(0); } }
  @keyframes lun-reach { 0%, 30%, 100% { transform: none; } 38% { transform: translateY(-22px) rotate(-20deg) scale(1.2); } 48% { transform: none; } }
  @keyframes lun-ripple { 0% { transform: scale(.6); opacity: .9; } 100% { transform: scale(3.4); opacity: 0; } }
  @keyframes lun-ping { 0%, 100% { transform: none; } 6% { transform: scale(1.25); } 16% { transform: none; } }
</style>

<script>
  import { initLunitas } from '@/scripts/lunita';
  initLunitas();
</script>
