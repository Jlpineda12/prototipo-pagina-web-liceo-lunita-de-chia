---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '@/lib/format';
interface Props { post: CollectionEntry<'noticias'>; featured?: boolean; index?: number; eager?: boolean }
const { post, featured = false, index = 0, eager = false } = Astro.props;
const { title, description, date, cover, category } = post.data;
const themeByCat: Record<string, string> = { Bandas: 't-purple', Celebraciones: 't-orange', Académico: 't-green', Excursiones: 't-sky', Noticias: 't-red' };
---

<article class:list={['news-card card', themeByCat[category], { featured }]} data-reveal style={`--d:${index}`}>
  <div class="media">
    {cover && <Image src={cover} alt="" widths={featured ? [360, 560, 800, 1100] : [320, 480, 640]} sizes={featured ? '(min-width: 960px) 50vw, calc(100vw - 32px)' : '(min-width: 960px) 25vw, (min-width: 720px) 45vw, calc(100vw - 32px)'} loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'auto' : 'low'} format="webp" quality={featured ? 68 : 60} />}
  </div>
  <div class="body">
    <div class="meta"><span class="chip">{category}</span><time datetime={date.toISOString()}>{formatDate(date)}</time></div>
    <h3><a href={`/noticias/${post.id}/`}>{title}</a></h3>
    {featured && <p>{description}</p>}
  </div>
</article>

<style>
  .news-card { display: flex; flex-direction: column; padding: 0; overflow: hidden; transition: transform 0.2s var(--ease), border-color 0.2s; }
  .news-card:hover { transform: translateY(-4px); border-color: var(--c); }
  .media { aspect-ratio: 16 / 10; overflow: hidden; background: var(--l); }
  .media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--ease); }
  .news-card:hover .media :global(img) { transform: scale(1.05); }
  .body { padding: 1.1rem 1.25rem 1.4rem; display: grid; gap: 0.55rem; }
  .meta { display: flex; align-items: center; gap: 0.7rem; flex-wrap: wrap; font-size: 0.82rem; font-weight: 700; color: var(--muted); }
  .chip { --l: color-mix(in srgb, var(--c) 14%, #fff); }
  h3 { font-size: 1.15rem; margin: 0; line-height: 1.25; }
  h3 a { color: var(--navy); text-decoration: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; }
  p { color: var(--muted); margin: 0; }
  .featured h3 { font-size: var(--step-2); }
  @media (min-width: 960px) { .featured .media { aspect-ratio: 16 / 9; } }
</style>
